---
// DiskMed Pádua — Plano de Ação Estratégico Comercial 2027 · V04 (página inicial, 7 blocos)
// Conteúdo: src/data/plan2027.ts · Componentes: src/components/plan2027/
// A proposta comercial anterior está em /proposta (src/pages/proposta.astro).
import Layout from "../layouts/Layout.astro";
import "../styles/plan2027.css";
import PlanNav from "../components/plan2027/PlanNav.astro";
import Opening from "../components/plan2027/Opening.astro";
import Diagnosis from "../components/plan2027/Diagnosis.astro";
import Levers from "../components/plan2027/Levers.astro";
import Execution from "../components/plan2027/Execution.astro";
import Goals from "../components/plan2027/Goals.astro";
import Roadmap from "../components/plan2027/Roadmap.astro";
import Closing from "../components/plan2027/Closing.astro";
import Annex from "../components/plan2027/Annex.astro";
import ExportDialog from "../components/plan2027/ExportDialog.astro";
import { docMeta } from "../data/plan2027";
---

<Layout
  title={`${docMeta.company} · ${docMeta.title}`}
  description="Plano de ação estratégico comercial 2027 da DiskMed Pádua: meta proposta de +15%, diagnóstico, cinco frentes de crescimento, liderança da execução, roadmap trimestral, indicadores e decisões para implantação."
  image="/og-plano-2027.png"
  noindex
>
  <a class="p-skip" href="#diagnostico">Pular para o conteúdo</a>
  <PlanNav />
  <main>
    <Opening />
    <Diagnosis />
    <Levers />
    <Execution />
    <Goals />
    <Roadmap />
    <Closing />
  </main>
  <Annex />
  <ExportDialog />
</Layout>

<script>
  import "../scripts/main.js";

  // ---------- Exportar PDF / responder pendências ----------
  // O botão "Exportar PDF" abre a janela; "Baixar PDF" fecha a janela e abre
  // o diálogo de impressão do navegador (@media print).
  const dialog = document.querySelector<HTMLDialogElement>("#export-dialog");
  const answers = dialog?.querySelector<HTMLFormElement>("[data-answers]");
  const status = dialog?.querySelector<HTMLElement>("[data-status]");
  const DRAFT_KEY = "diskmed-plano-2027-respostas";

  document.querySelectorAll<HTMLElement>("[data-export]").forEach((btn) => {
    btn.addEventListener("click", () => dialog?.showModal());
  });
  dialog?.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
  // Clique fora da janela fecha
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  document.querySelectorAll<HTMLElement>("[data-print]").forEach((btn) => {
    btn.addEventListener("click", () => {
      dialog?.close();
      setTimeout(() => window.print(), 50);
    });
  });

  // Rascunho local: o que já foi digitado volta se a janela for fechada
  // (só neste navegador; nada vai para servidor).
  const fields = () =>
    [...(answers?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea") ?? [])];
  const isRadio = (f: HTMLInputElement | HTMLTextAreaElement): f is HTMLInputElement =>
    f instanceof HTMLInputElement && f.type === "radio";
  try {
    const saved = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? "{}");
    fields().forEach((f) => {
      if (typeof saved[f.name] !== "string") return;
      if (isRadio(f)) f.checked = f.value === saved[f.name];
      else f.value = saved[f.name];
    });
  } catch {}
  answers?.addEventListener("input", () => {
    const draft: Record<string, string> = {};
    fields().forEach((f) => {
      if (!isRadio(f)) draft[f.name] = f.value;
      else if (f.checked) draft[f.name] = f.value;
    });
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    } catch {}
  });
  dialog?.querySelector("[data-clear]")?.addEventListener("click", () => {
    fields().forEach((f) => (isRadio(f) ? (f.checked = false) : (f.value = "")));
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {}
    if (status) status.textContent = "Respostas apagadas.";
  });

  // Envio: monta a mensagem só com o que foi respondido e abre o WhatsApp.
  answers?.addEventListener("submit", (e) => {
    e.preventDefault();
    const lines = ["*Plano Comercial 2027 · Validação da Diretoria*"];
    const who = answers.querySelector<HTMLInputElement>('[name="who"]')?.value.trim();
    if (who) lines.push(`Respondido por: ${who}`);
    let count = 0;
    answers.querySelectorAll<HTMLFieldSetElement>("fieldset[data-section]").forEach((fs) => {
      // Propostas: decisão marcada + comentário; demais campos: texto livre
      const proposals = [...fs.querySelectorAll<HTMLElement>("[data-proposal]")].map((p) => {
        const choice = p.querySelector<HTMLInputElement>("input:checked")?.value ?? "";
        const note = p.querySelector("textarea")?.value.trim() ?? "";
        return { label: p.dataset.proposal ?? "", value: [choice, note].filter(Boolean).join(" — ") };
      });
      const plain = [...fs.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-label]")].map((f) => ({
        label: f.dataset.label ?? f.name,
        value: f.value.trim(),
      }));
      const filled = [...proposals, ...plain].filter((f) => f.value);
      if (!filled.length) return;
      lines.push("", `*${fs.dataset.section}*`);
      filled.forEach((f) => lines.push(`${f.label}: ${f.value}`));
      count += filled.length;
    });
    if (!count) {
      if (status) status.textContent = "Responda ao menos um item antes de enviar.";
      return;
    }
    const url = `https://wa.me/${dialog?.dataset.wa}?text=${encodeURIComponent(lines.join("\n"))}`;
    window.open(url, "_blank", "noopener");
    if (status) status.textContent = `${count} ${count === 1 ? "resposta pronta" : "respostas prontas"} no WhatsApp. Confirme o envio por lá.`;
  });

  // Detalhes expansíveis: um link para um item dentro de <details> fechado
  // (ex.: marcador V5 → #v5) abre o detalhe antes de rolar até ele.
  const openTarget = (hash: string) => {
    if (!/^#[\w-]+$/.test(hash)) return;
    const target = document.querySelector(hash);
    target?.closest("details")?.setAttribute("open", "");
  };
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (link) openTarget(link.getAttribute("href") ?? "");
  });
  window.addEventListener("hashchange", () => openTarget(location.hash));
  if (location.hash) openTarget(location.hash);

  // PDF: os painéis expansíveis ficam fora; o conteúdo deles sai no anexo
  // (Annex.astro), via @media print — sem depender de JavaScript.

  // ---------- Seção ativa na barra superior ----------
  const navLinks = document.querySelectorAll<HTMLElement>("[data-spy]");
  const navStrip = document.querySelector<HTMLElement>(".p-nav__links");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // No mobile, a faixa de links rola até o link ativo.
  const revealActiveLink = () => {
    const active = navStrip?.querySelector<HTMLElement>('[aria-current="true"]');
    if (!navStrip || !active || navStrip.scrollWidth <= navStrip.clientWidth) return;
    const offset = active.getBoundingClientRect().left - navStrip.getBoundingClientRect().left;
    const left = navStrip.scrollLeft + offset - (navStrip.clientWidth - active.offsetWidth) / 2;
    navStrip.scrollTo({ left, behavior: reduce ? "auto" : "smooth" });
  };

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = (e.target as HTMLElement).id;
        navLinks.forEach((a) =>
          a.dataset.spy === id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")
        );
        revealActiveLink();
      });
    },
    // Faixa estreita no meio da tela: uma seção ativa por vez.
    { rootMargin: "-45% 0px -54% 0px" }
  );
  document.querySelectorAll<HTMLElement>("main > section[id]").forEach((s) => spy.observe(s));

  // ---------- Cinco frentes: foco em uma frente destaca sua linha ----------
  const levers = document.querySelector<HTMLElement>("[data-levers]");
  if (levers && window.matchMedia("(hover: hover)").matches) {
    levers.querySelectorAll<HTMLElement>("[data-front]").forEach((front) => {
      const line = levers.querySelector(`[data-line="${front.dataset.front}"]`);
      const on = () => {
        levers.setAttribute("data-active", "");
        front.setAttribute("data-on", "");
        line?.setAttribute("data-on", "");
      };
      const off = () => {
        levers.removeAttribute("data-active");
        front.removeAttribute("data-on");
        line?.removeAttribute("data-on");
      };
      front.addEventListener("mouseenter", on);
      front.addEventListener("mouseleave", off);
      front.addEventListener("focusin", on);
      front.addEventListener("focusout", off);
    });
  }
</script>

<style is:global>
  .p-skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 200;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    background: var(--p-green-dark);
    color: #fff;
    font-weight: 600;
  }
  .p-skip:focus {
    top: 1rem;
  }
  /* Âncoras não ficam escondidas sob a barra fixa */
  main section[id] {
    scroll-margin-top: 72px;
  }
  @media (max-width: 860px) {
    main section[id] {
      scroll-margin-top: 104px;
    }
  }
</style>
