---
// DiskMed Pádua — Plano de Ação Estratégico Comercial 2027 · V02 (página inicial)
// Conteúdo: src/data/plan2027.ts · Componentes: src/components/plan2027/
// A proposta comercial anterior está em /proposta (src/pages/proposta.astro).
import Layout from "../layouts/Layout.astro";
import "../styles/plan2027.css";
import PlanNav from "../components/plan2027/PlanNav.astro";
import Opening from "../components/plan2027/Opening.astro";
import Diagnosis from "../components/plan2027/Diagnosis.astro";
import Bottleneck from "../components/plan2027/Bottleneck.astro";
import Levers from "../components/plan2027/Levers.astro";
import Leadership from "../components/plan2027/Leadership.astro";
import Commercial from "../components/plan2027/Commercial.astro";
import Onboarding from "../components/plan2027/Onboarding.astro";
import Roadmap from "../components/plan2027/Roadmap.astro";
import Indicators from "../components/plan2027/Indicators.astro";
import Governance from "../components/plan2027/Governance.astro";
import Closing from "../components/plan2027/Closing.astro";
import { docMeta } from "../data/plan2027";
---

<Layout
  title={`${docMeta.company} · ${docMeta.title}`}
  description="Plano de ação estratégico comercial 2027 da DiskMed Pádua: meta proposta de +15%, diagnóstico, cinco frentes de crescimento, liderança da execução, roadmap trimestral, indicadores e decisões para implantação."
  image="/og-plano-2027.png"
  noindex
>
  <a class="p-skip" href="#diagnostico">Pular para o conteúdo</a>
  <PlanNav />
  <main>
    <Opening />
    <Diagnosis />
    <Bottleneck />
    <Levers />
    <Leadership />
    <Commercial />
    <Onboarding />
    <Roadmap />
    <Indicators />
    <Governance />
    <Closing />
  </main>
</Layout>

<script>
  import "../scripts/main.js";

  // Exportar / Imprimir PDF — diálogo nativo do navegador (@media print).
  document.querySelectorAll<HTMLElement>("[data-print]").forEach((btn) => {
    btn.addEventListener("click", () => window.print());
  });

  // Antes de imprimir: revela tudo e fixa os contadores no valor final
  // (uma animação em curso não pode sair no PDF como "+0%").
  window.addEventListener("beforeprint", () => {
    document
      .querySelectorAll("[data-reveal]")
      .forEach((el) => el.classList.add("is-visible"));
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const value = parseFloat(el.dataset.count ?? "");
      if (Number.isNaN(value)) return;
      const dec = parseInt(el.dataset.dec || "0", 10);
      el.textContent =
        (el.dataset.pre || "") +
        value.toLocaleString("pt-BR", {
          minimumFractionDigits: dec,
          maximumFractionDigits: dec,
          useGrouping: el.dataset.group === "1",
        }) +
        (el.dataset.suf || "");
    });
  });

  // ---------- Seção ativa: barra superior e trilho lateral ----------
  // A barra agrupa seções; o trilho mostra cada uma.
  const navGroup: Record<string, string> = {
    diagnostico: "diagnostico",
    gargalo: "diagnostico",
    frentes: "frentes",
    lideranca: "frentes",
    regras: "frentes",
    onboarding: "frentes",
    roadmap: "roadmap",
    indicadores: "indicadores",
    governanca: "indicadores",
    fechamento: "decisoes",
  };
  const railId = (id: string) => (id === "fechamento" ? "decisoes" : id);
  const rail = document.querySelector<HTMLElement>(".p-rail");
  const setCurrent = (els: NodeListOf<HTMLElement>, attr: string, value: string) =>
    els.forEach((a) =>
      a.dataset[attr] === value ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")
    );
  const navLinks = document.querySelectorAll<HTMLElement>("[data-spy]");
  const railLinks = document.querySelectorAll<HTMLElement>("[data-rail]");
  const navStrip = document.querySelector<HTMLElement>(".p-nav__links");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // No mobile, a faixa de links rola até o link ativo.
  const revealActiveLink = () => {
    const active = navStrip?.querySelector<HTMLElement>('[aria-current="true"]');
    if (!navStrip || !active || navStrip.scrollWidth <= navStrip.clientWidth) return;
    const offset = active.getBoundingClientRect().left - navStrip.getBoundingClientRect().left;
    const left = navStrip.scrollLeft + offset - (navStrip.clientWidth - active.offsetWidth) / 2;
    navStrip.scrollTo({ left, behavior: reduce ? "auto" : "smooth" });
  };

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const section = e.target as HTMLElement;
        const id = section.id;
        setCurrent(navLinks, "spy", navGroup[id] ?? "");
        setCurrent(railLinks, "rail", railId(id));
        revealActiveLink();
        rail?.toggleAttribute("data-on-dark", section.hasAttribute("data-dark"));
      });
    },
    // Faixa estreita no meio da tela: uma seção ativa por vez.
    { rootMargin: "-45% 0px -54% 0px" }
  );
  document.querySelectorAll<HTMLElement>("main > section[id]").forEach((s) => spy.observe(s));

  // ---------- Cinco frentes: foco em uma frente destaca sua linha ----------
  const levers = document.querySelector<HTMLElement>("[data-levers]");
  if (levers && window.matchMedia("(hover: hover)").matches) {
    levers.querySelectorAll<HTMLElement>("[data-front]").forEach((front) => {
      const line = levers.querySelector(`[data-line="${front.dataset.front}"]`);
      const on = () => {
        levers.setAttribute("data-active", "");
        front.setAttribute("data-on", "");
        line?.setAttribute("data-on", "");
      };
      const off = () => {
        levers.removeAttribute("data-active");
        front.removeAttribute("data-on");
        line?.removeAttribute("data-on");
      };
      front.addEventListener("mouseenter", on);
      front.addEventListener("mouseleave", off);
      front.addEventListener("focusin", on);
      front.addEventListener("focusout", off);
    });
  }
</script>

<style is:global>
  .p-skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 200;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    background: var(--p-green-dark);
    color: #fff;
    font-weight: 600;
  }
  .p-skip:focus {
    top: 1rem;
  }
  /* Âncoras não ficam escondidas sob a barra fixa */
  main section[id] {
    scroll-margin-top: 72px;
  }
  @media (max-width: 860px) {
    main section[id] {
      scroll-margin-top: 104px;
    }
  }
</style>
