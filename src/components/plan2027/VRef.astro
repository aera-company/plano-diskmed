---
// Marcador discreto de premissa pendente: aponta para a decisão
// correspondente no bloco "Decisões". V04: na apresentação principal é um
// ponto âmbar (sem código); o código V1…V10 aparece só nos detalhes (`code`).
import { validationById, type VId } from "../../data/plan2027";

interface Props {
  id: VId;
  /** Texto curto ao lado do marcador (ex.: "Base 2026 proposta"). */
  label?: string;
  /** Mostra o código da decisão (usado nos painéis de detalhe e no anexo). */
  code?: boolean;
  dark?: boolean;
  /** Sem link (ex.: anexo impresso, onde a âncora não existe). */
  static?: boolean;
}

const { id, label, code = false, dark = false, static: isStatic = false } = Astro.props;
const decision = validationById[id];
const done = decision.status === "Validado";
const Tag = isStatic ? "span" : "a";
---

<Tag
  class:list={["vref", { "vref--dark": dark, "vref--ok": done, "vref--dot": !code && !label }]}
  href={isStatic ? undefined : `#${id.toLowerCase()}`}
  title={`${done ? "Validado" : "Proposta aguardando validação"} · ${id}: ${decision.title}`}
  aria-label={`${done ? "Proposta validada" : "Proposta aguardando validação"} ${id}: ${decision.title}`}
>
  {!code && <span class="vref__dot" aria-hidden="true"></span>}
  {label && <span class="vref__label">{label}</span>}
  {code && <b>{id}</b>}
</Tag>
