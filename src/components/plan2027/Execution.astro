---
// Bloco 04 · Execução (V04) — Jefferson em três eixos e uma faixa com os
// números que importam: marcos de junho, três regras, onboarding e
// premiação. Governança e treinamento dia a dia ficam no "Plano operacional
// completo" (expansível na tela, anexo no PDF).
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import OpsDetails from "./details/OpsDetails.astro";
import {
  leadership,
  commercialRules,
  onboardingOnline,
  onboardingField,
  incentives,
} from "../../data/plan2027";

const rules = ["redes", "carteira", "territorio"]
  .map((k) => commercialRules.find((r) => r.key === k))
  .filter((r) => r !== undefined);
const ruleUnit: Record<string, string> = {
  redes: "por filial / mês",
  carteira: "CNPJs por representante",
  territorio: "raio máximo",
};
const days = [...onboardingOnline.map(() => "online"), ...onboardingField.map(() => "campo")];
---

<section id="execucao" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead num="04" eyebrow="Execução" title="Quem executa e com quais regras." lead={leadership.statement} split />

    <!-- Protagonistas: Jefferson e os marcos de junho -->
    <div class="ex__lead" data-motion>
      <div class="ex__who">
        <p class="p-label">{leadership.role}</p>
        <h3 class="ex__name">{leadership.name}</h3>
        <ol class="ex__axes">
          {
            leadership.axes.map((a, i) => (
              <li style={`--i:${i}`}>
                <strong>{a.label}</strong>
                <span>{a.short}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <section class="ex__jun" aria-labelledby="ex-jun">
        <h3 id="ex-jun" class="p-label">Até junho de 2027</h3>
        <ul>
          {
            leadership.milestones.map((m, i) => (
              <li style={`--i:${i}`}>
                <b><span>{m.value}</span></b>
                <span>
                  {m.value === "2" ? "novas indústrias" : "de positivação"}
                  <VRef id={m.v} />
                </span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Faixa secundária: regras, onboarding e premiação -->
    <div class="ex__band" data-reveal style="--reveal-delay:120ms">
      <section aria-labelledby="ex-rules">
        <h3 id="ex-rules" class="p-label">Regras propostas</h3>
        <ul class="ex__inline">
          {
            rules.map((r) => (
              <li>
                <b>{r.value.replace("R$ ", "R$\u00a0")}</b> {ruleUnit[r.key]}
                {r.v && <VRef id={r.v} />}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="ex-ob">
        <h3 id="ex-ob" class="p-label">Onboarding</h3>
        <p class="ex__ob"><b>5 dias</b> online + <b>3 dias</b> em campo</p>
        <ol class="ex__days" aria-hidden="true">
          {days.map((d) => <li class={`ex__day--${d}`} />)}
        </ol>
      </section>

      <section aria-labelledby="ex-aw">
        <h3 id="ex-aw" class="p-label">Premiação · três pilares</h3>
        <ul class="ex__inline">
          {
            incentives.map((p) => (
              <li>
                <b>{p.title}</b> {p.num === "01" ? p.bands.join(" / ") : p.bands[p.bands.length - 1]}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <More summary="Plano operacional completo" meta="governança, regras, treinamento e premiação">
      <OpsDetails />
    </More>
  </div>
</section>

<style>
  /* ---------- Linha principal: Jefferson + marcos de junho ---------- */
  .ex__lead {
    display: grid;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    padding-bottom: 1.5rem;
  }
  @media (min-width: 960px) {
    .ex__lead {
      grid-template-columns: 1.6fr 1fr;
      align-items: end;
    }
  }
  .ex__name {
    margin-top: 0.3rem;
    font-size: clamp(2.2rem, 1.7rem + 2vw, 3.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .ex__axes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem 1.5rem;
    margin-top: 1.1rem;
  }
  @media (min-width: 640px) {
    .ex__axes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ex__axes li {
    display: grid;
    gap: 0.1rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--p-green);
  }
  /* Desktop: uma linha horizontal liga Campo → Redes → Indústria */
  @media (min-width: 640px) {
    .ex__axes {
      position: relative;
      padding-top: 1rem;
    }
    .ex__axes::before,
    .ex__axes::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 2px;
      border-radius: 2px;
      background: var(--p-line-strong);
    }
    .ex__axes::after {
      background: var(--p-green);
      transform-origin: left;
    }
    .ex__axes li {
      position: relative;
      padding-left: 0;
      border-left: 0;
    }
    .ex__axes li::before {
      content: "";
      position: absolute;
      left: 0;
      top: calc(-1rem - 4px);
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--p-offwhite);
      border: 2px solid var(--p-green-dark);
    }
  }
  .ex__axes strong {
    color: var(--p-green-dark);
  }
  .ex__axes span {
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--p-gray);
  }
  .ex__jun ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
    margin-top: 0.5rem;
  }
  .ex__jun li {
    display: contents;
  }
  .ex__jun b {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
    font-size: clamp(2.6rem, 2rem + 2.4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .ex__jun li > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--p-graphite);
  }

  /* ---------- Faixa secundária ---------- */
  .ex__band {
    display: grid;
    gap: 1rem clamp(1.5rem, 3vw, 3rem);
    padding: 1rem 0 1.2rem;
    border-top: 2px solid var(--p-green-dark);
  }
  @media (min-width: 900px) {
    .ex__band {
      grid-template-columns: 1.3fr 0.9fr 1.3fr;
    }
  }
  .ex__band .p-label {
    margin-bottom: 0.4rem;
  }
  .ex__inline {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.1rem;
    font-size: 0.86rem;
    color: var(--p-gray);
  }
  .ex__inline li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .ex__inline b {
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--p-green-dark);
  }
  .ex__ob {
    font-size: 0.86rem;
    color: var(--p-gray);
  }
  .ex__ob b {
    font-size: var(--step-0);
    color: var(--p-green-dark);
  }
  .ex__days {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 3px;
    margin-top: 0.55rem;
    max-width: 14rem;
  }
  .ex__days li {
    height: 6px;
    border-radius: 3px;
  }
  .ex__day--online {
    background: var(--p-green);
    opacity: 0.45;
  }
  .ex__day--campo {
    background: var(--p-green-dark);
  }
  .ex__jun b span {
    display: inline-block;
  }

  /* ---------- Movimento ----------
     A linha percorre os três eixos; cada eixo entra quando ela passa.
     Os números de junho sobem de dentro da linha de base (só transform). */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .ex__axes::after {
      transform: scaleX(0);
      transition: transform var(--m-info) var(--m-ease) 150ms;
    }
    :global(.m-on) .ex__axes li,
    :global(.m-on) .ex__who > *:not(.ex__axes),
    :global(.m-on) .ex__jun .p-label,
    :global(.m-on) .ex__jun li > span {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
      transition: opacity var(--m-in) var(--m-ease), transform var(--m-in) var(--m-ease);
    }
    :global(.m-on) .ex__axes li {
      transition-delay: calc(250ms + var(--i) * 280ms);
    }
    :global(.m-on) .ex__jun .p-label {
      transition-delay: 200ms;
    }
    :global(.m-on) .ex__jun b span {
      transform: translate3d(0, 105%, 0);
      transition: transform 700ms var(--m-ease) calc(300ms + var(--i) * 120ms);
    }
    :global(.m-on) .ex__jun li > span {
      transition-delay: calc(450ms + var(--i) * 120ms);
    }
    :global(.m-on) .is-visible .ex__axes::after,
    :global(.m-on) .is-visible .ex__axes li,
    :global(.m-on) .is-visible .ex__who > *,
    :global(.m-on) .is-visible .ex__jun .p-label,
    :global(.m-on) .is-visible .ex__jun b span,
    :global(.m-on) .is-visible .ex__jun li > span {
      opacity: 1;
      transform: none;
    }
  }

  @media print {
    .ex__lead {
      grid-template-columns: 1.4fr 1fr;
      gap: 6mm;
    }
    .ex__jun li > span {
      font-size: 9pt;
    }
    .ex__axes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ex__band {
      grid-template-columns: 1.3fr 0.9fr 1.3fr;
      break-inside: avoid;
    }
    .ex__jun b {
      font-size: 22pt;
    }
  }
</style>
