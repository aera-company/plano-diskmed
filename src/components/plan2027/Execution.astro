---
// Bloco 04 · Execução (V04) — Jefferson em três eixos e uma faixa com os
// números que importam: marcos de junho, três regras, onboarding e
// premiação. Governança e treinamento dia a dia ficam no "Plano operacional
// completo" (expansível na tela, anexo no PDF).
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import OpsDetails from "./details/OpsDetails.astro";
import {
  leadership,
  commercialRules,
  onboardingOnline,
  onboardingField,
  incentives,
} from "../../data/plan2027";

const rules = ["redes", "carteira", "territorio"]
  .map((k) => commercialRules.find((r) => r.key === k))
  .filter((r) => r !== undefined);
const ruleUnit: Record<string, string> = {
  redes: "por filial / mês",
  carteira: "CNPJs por representante",
  territorio: "raio máximo",
};
const days = [...onboardingOnline.map(() => "online"), ...onboardingField.map(() => "campo")];
---

<section id="execucao" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead num="04" eyebrow="Execução" title="Quem executa e com quais regras." lead={leadership.statement} split />

    <div class="ex__lead">
      <div>
        <p class="p-label">{leadership.role}</p>
        <h3 class="ex__name">{leadership.name}</h3>
      </div>
      <ol class="ex__axes">
        {
          leadership.axes.map((a) => (
            <li>
              <strong>{a.label}</strong>
              <span>{a.short}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ex__band">
      <section aria-labelledby="ex-jun">
        <h3 id="ex-jun" class="p-label">Até junho de 2027</h3>
        <ul class="ex__nums">
          {
            leadership.milestones.map((m) => (
              <li>
                <b>{m.value}</b>
                <span>
                  {m.value === "2" ? "novas indústrias" : "de positivação"}
                  <VRef id={m.v} />
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="ex-rules">
        <h3 id="ex-rules" class="p-label">Regras propostas</h3>
        <ul class="ex__nums">
          {
            rules.map((r) => (
              <li>
                <b>{r.value.replace("R$ ", "R$ ")}</b>
                <span>
                  {ruleUnit[r.key]}
                  {r.v && <VRef id={r.v} />}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="ex-ob">
        <h3 id="ex-ob" class="p-label">Onboarding</h3>
        <p class="ex__ob"><b>5 dias</b> online + <b>3 dias</b> em campo</p>
        <ol class="ex__days" aria-hidden="true">
          {days.map((d) => <li class={`ex__day--${d}`} />)}
        </ol>
      </section>

      <section aria-labelledby="ex-aw">
        <h3 id="ex-aw" class="p-label">Premiação · três pilares</h3>
        <ol class="ex__pillars">
          {
            incentives.map((p) => (
              <li>
                <strong>{p.title}</strong>
                <span>{p.bands[p.bands.length - 1]}</span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <More summary="Plano operacional completo" meta="governança, regras, treinamento e premiação">
      <OpsDetails />
    </More>
  </div>
</section>

<style>
  .ex__lead {
    display: grid;
    gap: 1rem clamp(2rem, 4vw, 4rem);
    padding-bottom: 1.4rem;
  }
  @media (min-width: 960px) {
    .ex__lead {
      grid-template-columns: 0.8fr 2.2fr;
      align-items: end;
    }
  }
  .ex__name {
    margin-top: 0.3rem;
    font-size: clamp(2rem, 1.6rem + 1.8vw, 3rem);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .ex__axes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7rem 1.75rem;
  }
  @media (min-width: 640px) {
    .ex__axes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ex__axes li {
    display: grid;
    gap: 0.15rem;
    padding-left: 0.8rem;
    border-left: 2px solid var(--p-green);
  }
  .ex__axes strong {
    font-size: var(--step-0);
    color: var(--p-green-dark);
  }
  .ex__axes span {
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--p-gray);
  }

  /* ---------- Faixa de números ---------- */
  .ex__band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem clamp(1.25rem, 2.5vw, 2.5rem);
    padding: 1.2rem 0 1.4rem;
    border-top: 2px solid var(--p-green-dark);
  }
  @media (min-width: 1000px) {
    .ex__band {
      grid-template-columns: 1fr 1.25fr 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .ex__band {
      grid-template-columns: 1fr;
    }
  }
  .ex__band .p-label {
    margin-bottom: 0.6rem;
  }
  /* Números e rótulos em duas colunas alinhadas */
  .ex__nums {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: 0.45rem 0.7rem;
  }
  .ex__nums li {
    display: contents;
  }
  .ex__nums b {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--p-green-dark);
    white-space: nowrap;
  }
  .ex__nums span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.86rem;
    color: var(--p-graphite);
  }
  .ex__ob {
    font-size: var(--step-1);
    line-height: 1.25;
    color: var(--p-graphite);
  }
  .ex__ob b {
    color: var(--p-green-dark);
  }
  .ex__days {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 3px;
    margin-top: 0.7rem;
    max-width: 16rem;
  }
  .ex__days li {
    height: 8px;
    border-radius: 3px;
  }
  .ex__day--online {
    background: var(--p-green);
    opacity: 0.45;
  }
  .ex__day--campo {
    background: var(--p-green-dark);
  }
  .ex__pillars {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .ex__pillars li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--p-line-strong);
  }
  .ex__pillars strong {
    font-size: 0.95rem;
    color: var(--p-green-dark);
  }
  .ex__pillars span {
    font-size: 0.8rem;
    color: var(--p-gray);
    text-align: right;
  }
  @media print {
    .ex__lead {
      grid-template-columns: 0.8fr 2.2fr;
    }
    .ex__axes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ex__band {
      grid-template-columns: 1fr 1.25fr 1fr 1fr;
    }
    .ex__nums b {
      font-size: 15pt;
    }
  }
</style>
