---
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import { leadership } from "../../data/plan2027";
---

<section id="lideranca" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="04"
      eyebrow="Liderança da execução"
      title="Quem coordena a execução."
      lead={leadership.statement}
      split
    />

    <div class="ld">
      <div class="ld__id" data-reveal>
        <p class="ld__role">{leadership.role}</p>
        <h3 class="ld__name">{leadership.name}</h3>

        <ul class="ld__ms" aria-label="Marcos até junho de 2027">
          {
            leadership.milestones.map((m) => (
              <li>
                <span class="ld__ms-v">{m.value}</span>
                <span class="ld__ms-l">
                  {m.label}
                  <VRef id={m.v} label={m.note} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <ol class="ld__axes">
        {
          leadership.axes.map((a, i) => (
            <li class="ld__axis" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="ld__axis-num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              {a.key === "industria" && (
                <div class="ld__targets">
                  <span>Alvos de negociação · não são parceiros fechados</span>
                  <ul>
                    {leadership.targetIndustries.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ld__part" data-reveal>
      <p class="ld__part-title">Como as áreas participam</p>
      <ul>
        {
          leadership.participation.map((p) => (
            <li>
              <span class="ld__verb">{p.verb}</span>
              <strong>{p.name}</strong>
              <span class="ld__ptext">{p.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="ld__part-note">Relação funcional entre as áreas; não define vínculo hierárquico formal.</p>
    </div>
  </div>
</section>

<style>
  .ld {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 1040px) {
    .ld {
      grid-template-columns: 0.8fr 1.6fr;
      align-items: start;
    }
  }
  .ld__role {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-green-text);
  }
  .ld__name {
    margin-top: 0.5rem;
    font-size: clamp(2.2rem, 1.7rem + 2vw, 3.2rem);
    letter-spacing: -0.035em;
    color: var(--p-green-dark);
  }
  .ld__ms {
    list-style: none;
    padding: 0;
    margin-top: 1.8rem;
    display: grid;
  }
  .ld__ms li {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-top: 1px solid var(--p-line-strong);
  }
  .ld__ms-v {
    font-size: clamp(2.2rem, 1.8rem + 1.4vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .ld__ms-l {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--p-graphite);
    line-height: 1.4;
  }

  .ld__axes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 760px) {
    .ld__axes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ld__axis {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.3rem 0;
    border-top: 2px solid var(--p-green-dark);
  }
  @media (min-width: 760px) {
    .ld__axis {
      padding: 1.3rem 1.4rem 0;
    }
    .ld__axis + .ld__axis {
      border-left: 1px solid var(--p-line-strong);
    }
    .ld__axis:first-child {
      padding-left: 0;
    }
  }
  .ld__axis-num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--p-green-text);
  }
  .ld__axis h3 {
    font-size: var(--step-1);
    color: var(--p-green-dark);
    letter-spacing: -0.02em;
    overflow-wrap: normal;
  }
  .ld__axis p {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--p-graphite);
  }
  .ld__targets {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.6rem;
  }
  .ld__targets > span {
    font-size: 0.72rem;
    color: var(--p-gray);
  }
  .ld__targets ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ld__targets li {
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    border: 1px dashed var(--p-line-strong);
    background: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--p-green-dark);
  }

  .ld__part {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--p-line-strong);
  }
  .ld__part-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-gray);
  }
  .ld__part ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: grid;
    gap: 1rem 1.75rem;
  }
  @media (min-width: 720px) {
    .ld__part ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .ld__part ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ld__part li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }
  .ld__verb {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-green-text);
  }
  .ld__part strong {
    font-size: var(--step-0);
    color: var(--p-graphite);
  }
  .ld__ptext {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--p-gray);
  }
  .ld__part-note {
    margin-top: 1.1rem;
    font-size: 0.78rem;
    color: var(--p-gray);
  }
</style>
