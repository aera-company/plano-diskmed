---
import SectionHead from "./SectionHead.astro";
import Badge from "./Badge.astro";
import { incentives, incentivesMechanicNote } from "../../data/plan2027";

// Marcadores da régua de positivação (valores do plano).
// A régua vai de 50% a 100% para que as faixas fiquem legíveis.
const positivationMarks = [65, 75, 82];
const scaleMin = 50;
const pos = (v: number) => ((v - scaleMin) / (100 - scaleMin)) * 100;
---

<section id="incentivos" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="06"
      eyebrow="Incentivos"
      title="Três pilares de performance."
      lead="A premiação reforça o que sustenta a meta: clientes ativos, mix por indústria e carteira saudável. Regras e valores ainda dependem de validação."
      split
    />

    <div class="ic">
      {
        incentives.map((p, i) => (
          <article class="p-card ic__card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="ic__num">{p.num}</span>
            <h3>{p.title}</h3>

            {i === 0 && (
              <div class="ic__scale" role="img" aria-label="Faixas propostas de positivação: 65%, 75% e acima de 82%">
                <div class="ic__track">
                  {positivationMarks.map((m, k) => (
                    <span class="ic__seg" style={`left:${pos(m)}%; --o:${0.4 + k * 0.3}`} />
                  ))}
                  {positivationMarks.map((m) => (
                    <span class="ic__mark" style={`left:${pos(m)}%`}>
                      <b>{m}%</b>
                    </span>
                  ))}
                </div>
                <div class="ic__axis">
                  <span>{scaleMin}%</span>
                  <span>100%</span>
                </div>
              </div>
            )}

            <ul class="ic__bands">
              {p.bands.map((b) => <li>{b}</li>)}
            </ul>
            <p class="ic__text">{p.text}</p>
            <p class="p-pending">{p.pending}</p>
          </article>
        ))
      }
    </div>

    <div class="ic__mech p-avoid-break" data-reveal>
      <div>
        <p class="ic__mech-title">Mecânica financeira da premiação</p>
        <p class="ic__mech-note">{incentivesMechanicNote}</p>
      </div>
      <Badge status="validar" label="A validar" />
    </div>
  </div>
</section>

<style>
  .ic {
    display: grid;
    gap: clamp(0.9rem, 1.6vw, 1.25rem);
  }
  @media (min-width: 900px) {
    .ic {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ic__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ic__num {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--p-green-text);
  }
  .ic__card h3 {
    font-size: var(--step-2);
    color: var(--p-green-dark);
    letter-spacing: -0.025em;
  }
  .ic__bands {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .ic__bands li {
    padding: 0.5rem 0.85rem;
    border-radius: 100px;
    background: var(--p-green-dark);
    color: #fff;
    font-weight: 600;
    font-size: var(--step--1);
  }
  .ic__text {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--p-graphite);
    margin-bottom: auto;
  }

  .ic__scale {
    padding: 1.6rem 0 0.2rem;
  }
  .ic__track {
    position: relative;
    height: 10px;
    border-radius: 10px;
    background: var(--p-offwhite);
    border: 1px solid var(--p-line);
  }
  .ic__seg {
    position: absolute;
    top: -1px;
    bottom: -1px;
    right: 0;
    border-radius: 0 10px 10px 0;
    background: var(--p-green);
    opacity: var(--o);
  }
  .ic__mark {
    position: absolute;
    top: -6px;
    width: 2px;
    height: 20px;
    margin-left: -1px;
    background: var(--p-green-dark);
  }
  .ic__mark b {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.72rem;
    color: var(--p-green-dark);
  }
  .ic__axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.68rem;
    color: var(--p-gray);
  }

  .ic__mech {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.3rem 1.6rem;
    border-radius: 16px;
    border: 1.5px dashed rgba(233, 167, 58, 0.6);
    background: #fffdf8;
  }
  .ic__mech-title {
    font-weight: 700;
    color: var(--p-graphite);
    font-size: var(--step-1);
  }
  .ic__mech-note {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--p-gray);
    max-width: 70ch;
  }
</style>
