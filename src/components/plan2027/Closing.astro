---
// Bloco 07 · Decisões (V04) — só as três decisões prioritárias visíveis, sem
// códigos; as demais em um único painel expansível (com âncoras #v4…#v10).
// Status mantido em src/data/plan2027.ts; a página não registra aprovações.
import Icon from "./Icon.astro";
import More from "./More.astro";
import OtherDecisions from "./details/OtherDecisions.astro";
import { closing, validations, docMeta, VALIDATION_STATUS_LABEL } from "../../data/plan2027";

const priority = validations.filter((v) => v.priority);
const othersCount = validations.length - priority.length;
---

<section id="decisoes" class="p-section p-section--dark cl" data-dark>
  <div class="container container-wide">
    <p class="eyebrow eyebrow--line" data-num="07" data-reveal>Decisões</p>
    <h2 class="cl__title" data-reveal style="--reveal-delay:90ms">Três decisões para iniciar a implantação.</h2>

    <ol class="dc">
      {
        priority.map((v, i) => (
          <li id={v.id.toLowerCase()} data-reveal style={`--reveal-delay:${180 + i * 90}ms`}>
            <span class="dc__n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{v.headline ?? v.title}</h3>
            <p>{v.proposal}</p>
            <span class:list={["dc__status", { "dc__status--ok": v.status === "Validado" }]}>
              {VALIDATION_STATUS_LABEL[v.status]}
            </span>
          </li>
        ))
      }
    </ol>

    <More summary="Outras definições operacionais" meta={`${othersCount} itens`} dark id="outras-definicoes">
      <OtherDecisions anchors />
    </More>

    <!-- Assinatura executiva -->
    <figure class="sig" data-motion>
      <span class="sig__line" aria-hidden="true"></span>
      <blockquote class="sig__q">{closing.signature}</blockquote>
      <figcaption>
        <strong>{docMeta.author}</strong>
        <span>{docMeta.authorRole}</span>
      </figcaption>
    </figure>

    <div class="cl__next">
      <p class="cl__cta">
        <span>Próximo passo</span>
        {closing.cta}
      </p>
      <button type="button" class="btn btn--ghost cl__print no-print" data-export aria-haspopup="dialog">
        <Icon name="check" size={18} />
        Validar propostas
      </button>
    </div>

    <footer class="cl__foot">
      <span class="cl__logo">
        <img src="/images/logo-diskmed.png" alt="DiskMed Pádua" width="600" height="171" loading="lazy" decoding="async" />
      </span>
      <span>{docMeta.title} · {docMeta.version}</span>
      <a class="cl__top no-print" href="#ambicao">Voltar ao início <span aria-hidden="true">↑</span></a>
    </footer>
  </div>
</section>

<style>
  .cl__title {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.1rem);
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: #fff;
    max-width: 22ch;
  }

  /* ---------- Três decisões: composição editorial ---------- */
  .dc {
    list-style: none;
    padding: 0;
    display: grid;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 900px) {
    .dc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .dc li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    justify-items: start;
    padding: 1.3rem 1.5rem 1.4rem 0;
    scroll-margin-top: 110px;
  }
  @media (min-width: 900px) {
    .dc li + li {
      padding-left: 1.5rem;
      border-left: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
  @media (max-width: 899px) {
    .dc li + li {
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
  .dc li:target {
    animation: dcFlash 1.8s var(--ease);
  }
  @keyframes dcFlash {
    0%,
    35% {
      background: rgba(233, 167, 58, 0.16);
    }
  }
  .dc__n {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green);
  }
  .dc h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .dc p {
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
  }
  .dc__status--ok {
    background: var(--p-soft) !important;
    color: var(--p-green-mid) !important;
  }
  .dc__status {
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: var(--p-amber-bg);
    color: var(--p-amber-ink);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Próximo passo ---------- */
  .cl__next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .cl__cta {
    display: grid;
    gap: 0.3rem;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cl__cta span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-green);
  }
  .cl__print {
    --fg: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  .cl__print:hover {
    --fg: #fff;
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* ---------- Assinatura executiva ---------- */
  .sig {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    max-width: 44rem;
  }
  .sig__line {
    display: block;
    width: 3.5rem;
    height: 2px;
    margin-bottom: 1.1rem;
    background: var(--p-green);
    transform-origin: left;
  }
  .sig__q {
    margin: 0;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .sig figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    margin-top: 0.9rem;
    font-size: var(--step--1);
  }
  .sig figcaption strong {
    color: #fff;
    font-weight: 600;
  }
  .sig figcaption span {
    color: rgba(255, 255, 255, 0.62);
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .sig__line {
      transform: scaleX(0);
      transition: transform 700ms var(--m-ease);
    }
    :global(.m-on) .sig__q,
    :global(.m-on) .sig figcaption {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
      transition: opacity var(--m-in) var(--m-ease) 350ms, transform var(--m-in) var(--m-ease) 350ms;
    }
    :global(.m-on) .sig figcaption {
      transition-delay: 500ms;
    }
    :global(.m-on) .sig.is-visible .sig__line,
    :global(.m-on) .sig.is-visible .sig__q,
    :global(.m-on) .sig.is-visible figcaption {
      opacity: 1;
      transform: none;
    }
  }

  .cl__top {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 0.25em;
    transition: color var(--m-micro) var(--m-ease), text-decoration-color var(--m-micro) var(--m-ease);
  }
  .cl__top:hover {
    color: #fff;
    text-decoration-color: var(--p-green);
  }
  .cl__foot {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
  }
  .cl__logo {
    display: inline-flex;
    padding: 0.5rem 0.8rem;
    border-radius: 10px;
    background: #fff;
  }
  .cl__logo img {
    height: 26px;
    width: auto;
  }
  @media print {
    .cl {
      break-before: page;
    }
    .dc li {
      break-inside: avoid;
    }
    .dc h3 {
      font-size: 13pt;
    }
    .dc p {
      font-size: 8pt;
    }
    .sig {
      margin-top: 5mm;
    }
    .sig__q {
      font-size: 14pt;
    }
    .cl__next {
      margin-top: 4mm;
    }
    .cl__cta {
      font-size: 11pt;
    }
    .cl__foot {
      margin-top: 4mm;
      padding-top: 3mm;
    }
    .dc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .dc li + li {
      padding-left: 4mm;
      border-left: 1px solid rgba(255, 255, 255, 0.14);
      border-top: 0;
    }
  }
</style>
