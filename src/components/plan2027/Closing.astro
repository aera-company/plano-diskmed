---
// Bloco 07 · Decisões (V04) — só as três decisões prioritárias visíveis, sem
// códigos; as demais em um único painel expansível (com âncoras #v4…#v10).
// Status mantido em src/data/plan2027.ts; a página não registra aprovações.
import Icon from "./Icon.astro";
import More from "./More.astro";
import OtherDecisions from "./details/OtherDecisions.astro";
import { closing, validations, docMeta } from "../../data/plan2027";

const priority = validations.filter((v) => v.priority);
const othersCount = validations.length - priority.length;
---

<section id="decisoes" class="p-section p-section--dark cl" data-dark>
  <div class="container container-wide">
    <p class="eyebrow eyebrow--line" data-num="07">Decisões</p>
    <h2 class="cl__title">Três decisões para iniciar a implantação.</h2>

    <ol class="dc">
      {
        priority.map((v, i) => (
          <li id={v.id.toLowerCase()}>
            <span class="dc__n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{v.headline ?? v.title}</h3>
            <p>{v.detail}</p>
            <span class="dc__status">{v.status}</span>
          </li>
        ))
      }
    </ol>

    <More summary="Outras definições operacionais" meta={`${othersCount} itens`} dark id="outras-definicoes">
      <OtherDecisions anchors />
    </More>

    <div class="cl__next">
      <p class="cl__cta">
        <span>Próximo passo</span>
        {closing.cta}
      </p>
      <button type="button" class="btn btn--ghost cl__print no-print" data-print>
        <Icon name="print" size={18} />
        Exportar PDF
      </button>
    </div>

    <footer class="cl__foot">
      <span class="cl__logo">
        <img src="/images/logo-diskmed.png" alt="DiskMed Pádua" width="600" height="171" loading="lazy" decoding="async" />
      </span>
      <span>
        {docMeta.title} · {docMeta.version}
        <br />
        {docMeta.author} · {docMeta.authorRole}
      </span>
    </footer>
  </div>
</section>

<style>
  .cl__title {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.1rem);
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: #fff;
    max-width: 22ch;
  }

  /* ---------- Três decisões: composição editorial ---------- */
  .dc {
    list-style: none;
    padding: 0;
    display: grid;
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 900px) {
    .dc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .dc li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    justify-items: start;
    padding: 1.3rem 1.5rem 1.4rem 0;
    scroll-margin-top: 110px;
  }
  @media (min-width: 900px) {
    .dc li + li {
      padding-left: 1.5rem;
      border-left: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
  @media (max-width: 899px) {
    .dc li + li {
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
  .dc li:target {
    animation: dcFlash 1.8s var(--ease);
  }
  @keyframes dcFlash {
    0%,
    35% {
      background: rgba(233, 167, 58, 0.16);
    }
  }
  .dc__n {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green);
  }
  .dc h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .dc p {
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
  }
  .dc__status {
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: var(--p-amber-bg);
    color: var(--p-amber-ink);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Próximo passo ---------- */
  .cl__next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .cl__cta {
    display: grid;
    gap: 0.3rem;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cl__cta span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-green);
  }
  .cl__print {
    --fg: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  .cl__print:hover {
    --fg: #fff;
    border-color: #fff;
  }
  .cl__foot {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
  }
  .cl__logo {
    display: inline-flex;
    padding: 0.5rem 0.8rem;
    border-radius: 10px;
    background: #fff;
  }
  .cl__logo img {
    height: 26px;
    width: auto;
  }
  @media print {
    .dc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .dc li + li {
      padding-left: 4mm;
      border-left: 1px solid rgba(255, 255, 255, 0.14);
      border-top: 0;
    }
  }
</style>
