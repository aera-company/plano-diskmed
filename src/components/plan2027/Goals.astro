---
// Bloco 05 · Metas (V04) — quatro indicadores principais em destaque e três
// complementares em uma linha. Definições técnicas no painel expansível.
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import GoalDetails from "./details/GoalDetails.astro";
import { indicators } from "../../data/plan2027";

const main = ["Crescimento anual", "Positivação", "Ticket médio", "Inadimplência"];
const primary = indicators.filter((i) => main.includes(i.name));
const support = indicators.filter((i) => !main.includes(i.name));
// "<2%" lido como "inferior a 2%" pelo leitor de tela
const spoken = (t: string) => t.replace("<", "inferior a ");
---

<section id="metas" class="p-section">
  <div class="container container-wide">
    <SectionHead
      num="05"
      eyebrow="Metas"
      title="O que será medido em 2027."
      lead="Metas propostas. Resultados entram a partir da primeira apuração."
      split
    />

    <ul class="gl" data-motion>
      {
        primary.map((i, k) => (
          <li style={`--i:${k}`}>
            <span class="gl__v" aria-label={spoken(i.target)}><span>{i.target}</span></span>
            <span class="gl__n">
              {i.name}
              <VRef id={i.v} />
            </span>
          </li>
        ))
      }
    </ul>

    <ul class="gl__support" data-reveal style="--reveal-delay:200ms">
      {
        support.map((i) => (
          <li>
            <b aria-label={spoken(i.target)}>{i.target}</b>
            <span>{i.name}</span>
          </li>
        ))
      }
      <li class="gl__ref"><VRef id="V8" label="definições propostas" /></li>
    </ul>

    <More summary="Definições técnicas dos indicadores" meta={`${indicators.length} indicadores`}>
      <GoalDetails />
    </More>
  </div>
</section>

<style>
  .gl {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--p-green-dark);
  }
  @media (min-width: 900px) {
    .gl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .gl li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.1rem 1rem 1.2rem 0;
  }
  @media (min-width: 900px) {
    .gl li + li {
      padding-left: 1.4rem;
      border-left: 1px solid var(--p-line);
    }
  }
  .gl__v {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
    font-size: clamp(3rem, 1.6rem + 5vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: var(--p-green-dark);
    white-space: nowrap;
  }
  .gl li:first-child .gl__v {
    color: var(--p-green-text);
  }
  .gl__v span {
    display: inline-block;
  }
  .gl__n {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--p-graphite);
  }
  .gl__support {
    list-style: none;
    padding: 0.8rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2.25rem;
    border-top: 1px solid var(--p-line);
  }
  .gl__support li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .gl__support b {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--p-green-dark);
  }
  .gl__support span {
    font-size: var(--step--1);
    color: var(--p-gray);
  }
  .gl__ref {
    margin-left: auto;
    font-size: 0.8rem;
  }
  /* Movimento: cada meta sobe da linha de base, em sequência (sem contagem
     numérica — não sugerir desempenho realizado). */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .gl {
      border-top-color: transparent;
      background: linear-gradient(var(--p-green-dark), var(--p-green-dark)) top left / 0% 2px no-repeat;
      transition: background-size var(--m-info) var(--m-ease);
    }
    :global(.m-on) .gl.is-visible {
      background-size: 100% 2px;
    }
    :global(.m-on) .gl__v span {
      transform: translate3d(0, 105%, 0);
      transition: transform 700ms var(--m-ease) calc(150ms + var(--i) * var(--m-step));
    }
    :global(.m-on) .gl__n {
      opacity: 0;
      transition: opacity var(--m-in) var(--m-ease) calc(350ms + var(--i) * var(--m-step));
    }
    :global(.m-on) .gl.is-visible .gl__v span {
      transform: none;
    }
    :global(.m-on) .gl.is-visible .gl__n {
      opacity: 1;
    }
  }

  @media print {
    .gl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .gl li + li {
      padding-left: 4mm;
      border-left: 1px solid var(--p-line);
    }
    .gl__v {
      font-size: 28pt;
    }
  }
</style>
