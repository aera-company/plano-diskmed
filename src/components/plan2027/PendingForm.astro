---
// Validação da Diretoria (só no PDF): propostas V1–V10 com decisão e
// comentário, dados que a DiskMed libera e definições comerciais.
import { validations, pendingIntro, pendingData, pendingOps } from "../../data/plan2027";

const groups = [
  { title: "Propostas prioritárias", items: validations.filter((v) => v.priority) },
  { title: "Demais propostas", items: validations.filter((v) => !v.priority) },
];
const options = ["Aprovo", "Aprovo com ajuste", "Não aprovo"];
---

<div class="pf">
  <p class="pf__intro">{pendingIntro}</p>

  {
    groups.map((g) => (
      <section class="pf__g">
        <h3>{g.title}</h3>
        <table class="pf__t">
          <thead>
            <tr>
              <th>Código</th>
              <th>Proposta</th>
              <th>Decisão e comentário</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((v) => (
              <tr>
                <td class="pf__id">{v.id}</td>
                <td>
                  <b class="pf__title">{v.headline ?? v.title}</b>
                  {v.proposal}
                </td>
                <td>
                  <ul class="pf__opts">
                    {options.map((o) => (
                      <li>
                        <span aria-hidden="true" />
                        {o}
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }

  <section class="pf__g">
    <h3>Dados para apuração</h3>
    <p class="pf__note">Com estes dados o painel passa a mostrar resultado atual e desvio de cada meta.</p>
    <table class="pf__t pf__t--3">
      <thead><tr><th>Dado</th><th>Para qual indicador</th><th>Quem envia</th></tr></thead>
      <tbody>{pendingData.map((d) => <tr><td>{d.data}</td><td>{d.indicator}</td><td /></tr>)}</tbody>
    </table>
  </section>

  <section class="pf__g">
    <h3>Definições comerciais</h3>
    <table class="pf__t pf__t--3">
      <thead><tr><th>Definição</th><th>Uso no plano</th><th>Resposta</th></tr></thead>
      <tbody>{pendingOps.map((o) => <tr><td>{o.info}</td><td>{o.use}</td><td /></tr>)}</tbody>
    </table>
  </section>
</div>

<style>
  /* A tabela pode quebrar entre linhas; o título fica com a primeira linha */
  .pf__g h3,
  .pf__g .pf__note {
    break-after: avoid;
  }
  .pf__t thead {
    display: table-header-group;
  }
  .pf__intro {
    margin-bottom: 4mm;
    font-size: 10pt;
    line-height: 1.5;
  }
  .pf h3 {
    margin: 5mm 0 2mm;
    font-size: 11pt;
    color: var(--p-green-dark);
    break-after: avoid;
  }
  .pf__note {
    margin-bottom: 2mm;
    color: var(--p-gray);
  }
  .pf__t {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .pf__t th,
  .pf__t td {
    padding: 2mm 2.5mm;
    border: 1px solid var(--p-line-strong);
    text-align: left;
    vertical-align: top;
  }
  .pf__t th {
    background: var(--p-offwhite);
    font-size: 7.5pt;
    font-weight: 600;
    color: var(--p-gray);
  }
  .pf__t tr {
    break-inside: avoid;
  }
  .pf__t th:nth-child(1) {
    width: 13mm;
  }
  .pf__t th:nth-child(3) {
    width: 52mm;
  }
  .pf__t--3 th:nth-child(1) {
    width: auto;
  }
  .pf__t--3 th:nth-child(2) {
    width: 52mm;
  }
  .pf__t--3 th:nth-child(3) {
    width: 46mm;
  }
  .pf__t td {
    height: 10mm;
  }
  .pf__id {
    font-weight: 700;
    color: var(--p-green-text);
  }
  .pf__title {
    display: block;
    margin-bottom: 0.8mm;
    color: var(--p-green-dark);
  }
  .pf__opts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1mm;
    margin-bottom: 8mm;
    font-size: 8pt;
  }
  .pf__opts li {
    display: flex;
    align-items: center;
    gap: 1.5mm;
  }
  .pf__opts span {
    width: 3mm;
    height: 3mm;
    border: 1px solid var(--p-gray);
    border-radius: 0.6mm;
  }
</style>
