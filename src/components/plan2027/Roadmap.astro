---
// Bloco 06 · Roadmap — uma única representação: quatro trimestres com o marco
// acumulado proposto (barra crescente) e os entregáveis. Ações em detalhe.
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import { quarters, milestonesNote, type DeliveryStatus } from "../../data/plan2027";

const max = quarters[quarters.length - 1].milestone;
const statusClass: Record<DeliveryStatus, string> = {
  Planejado: "planned",
  "Em andamento": "doing",
  Concluído: "done",
  "Em risco": "risk",
};
const all = quarters.flatMap((q) => q.deliverables);
const statusCount = (Object.keys(statusClass) as DeliveryStatus[])
  .map((s) => ({ s, n: all.filter((d) => d.status === s).length }))
  .filter((c) => c.n > 0);
---

<section id="roadmap" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="06"
      eyebrow="Roadmap 2027"
      title="Quatro trimestres até +15%."
      lead="Cada trimestre tem um foco, um marco de crescimento acumulado e entregáveis verificáveis."
      split
    />

    <ol class="rm">
      {
        quarters.map((q, i) => (
          <li class="rm__q" data-reveal style={`--reveal-delay:${i * 60}ms; --h:${(q.milestone / max) * 100}%`}>
            <header class="rm__head">
              <p class="rm__id">
                <b>{q.q}</b> {q.months}
              </p>
              <div class="rm__ms">
                <span class="rm__bar" aria-hidden="true"><i /></span>
                <span class="rm__v">
                  +{q.milestone}%<small>acumulado</small>
                </span>
              </div>
              <h3>{q.theme}</h3>
            </header>
            <ul class="rm__deliv" aria-label={`Entregáveis ${q.q}`}>
              {q.deliverables.map((d) => (
                <li>
                  {d.text}
                  {d.v && <VRef id={d.v} />}
                  {d.status !== "Planejado" && <span class={`rm__st rm__st--${statusClass[d.status]}`}>{d.status}</span>}
                </li>
              ))}
            </ul>
            <More summary="Ações do trimestre" meta={String(q.actions.length)}>
              <ul class="rm__actions">
                {q.actions.map((a) => (
                  <li>
                    {a.text}
                    {a.v && <VRef id={a.v} />}
                  </li>
                ))}
              </ul>
            </More>
          </li>
        ))
      }
    </ol>

    <p class="rm__cap" data-reveal>
      <span>{milestonesNote}</span>
      <VRef id="V1" label="Base 2026" />
      <span class="rm__track">
        Entregáveis: {statusCount.map((c) => <span><b>{c.n}</b> {c.s.toLowerCase()}{c.n > 1 ? "s" : ""}</span>)}
      </span>
    </p>
  </div>
</section>

<style>
  .rm {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.8rem, 1.5vw, 1.1rem);
  }
  @media (min-width: 720px) {
    .rm {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1140px) {
    .rm {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .rm__q {
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 2vw, 1.4rem) clamp(1.1rem, 2vw, 1.4rem) 0.2rem;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--p-line);
  }
  .rm__id {
    font-size: 0.8rem;
    color: var(--p-gray);
  }
  .rm__id b {
    margin-right: 0.25rem;
    font-size: var(--step-0);
    color: var(--p-green-dark);
  }
  /* Marco: barra crescente + número (a trajetória lida nos quatro cartões) */
  .rm__ms {
    display: flex;
    align-items: flex-end;
    gap: 0.8rem;
    height: 5.2rem;
    margin-top: 0.8rem;
  }
  .rm__bar {
    position: relative;
    width: 12px;
    height: 100%;
    border-radius: 6px;
    background: var(--p-offwhite);
    border: 1px solid var(--p-line);
    overflow: hidden;
  }
  .rm__bar i {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--h);
    background: var(--p-green);
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 0.7s var(--ease) 0.15s;
  }
  .rm__q:last-child .rm__bar i {
    background: var(--p-green-dark);
  }
  .is-visible .rm__bar i {
    transform: none;
  }
  .rm__v {
    display: grid;
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.85;
    color: var(--p-green-dark);
  }
  .rm__v small {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-gray);
  }
  .rm__head h3 {
    margin-top: 0.9rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--p-line);
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    color: var(--p-graphite);
  }
  .rm__deliv {
    list-style: none;
    padding: 0.8rem 0 1rem;
    display: grid;
    gap: 0.55rem;
    margin-bottom: auto;
  }
  .rm__deliv li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--p-graphite);
  }
  .rm__deliv li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 3px;
    border: 1.5px solid var(--p-green-mid);
  }
  .rm__deliv :global(.vref),
  .rm__actions :global(.vref) {
    margin-left: 0.3rem;
  }
  .rm__st {
    margin-left: 0.4rem;
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .rm__st--doing {
    background: var(--p-amber-bg);
    color: var(--p-amber-ink);
  }
  .rm__st--done {
    background: var(--p-soft);
    color: var(--p-green-mid);
  }
  .rm__st--risk {
    background: var(--p-red-bg);
    color: var(--p-red-ink);
  }
  .rm__actions {
    padding-left: 1rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.84rem;
  }
  .rm__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--p-gray);
  }
  .rm__track {
    display: inline-flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .rm__track b {
    color: var(--p-graphite);
  }
  @media print {
    .rm__bar i {
      transform: none;
    }
  }
</style>
