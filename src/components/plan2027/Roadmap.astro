---
// Bloco 06 · Roadmap — uma única timeline (horizontal no desktop, vertical no
// mobile) com quatro trimestres: marco acumulado, título e até três
// entregáveis. No Q2, os marcos de junho em destaque. O cronograma completo
// fica no painel expansível / anexo.
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import RoadmapDetails from "./details/RoadmapDetails.astro";
import { quarters, juneMilestones } from "../../data/plan2027";

const SHOW = 3;
---

<section id="roadmap" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="06"
      eyebrow="Roadmap 2027"
      title="Quatro trimestres até +15%."
      lead="Marcos de crescimento acumulado propostos, sobre a base 2026."
      split
    />

    <ol class="tl" data-motion>
      {
        quarters.map((q, i) => (
          <li class="tl__q" style={`--i:${i}`}>
            <p class="tl__when">
              <b>{q.q}</b> {q.months}
            </p>
            <p class="tl__v">
              +{q.milestone}%
              {q.q === "Q4" && <VRef id="V1" />}
            </p>
            <h3>{q.theme}</h3>
            <ul>
              {q.deliverables
                .filter((d) => !d.june)
                .slice(0, SHOW)
                .map((d) => (
                  <li>
                    {d.text} {d.v && <VRef id={d.v} />}
                  </li>
                ))}
            </ul>
            {q.deliverables.some((d) => d.june) && (
              <div class="tl__june">
                <p class="p-label">Marcos de junho</p>
                <ul>
                  {juneMilestones.map((m) => (
                    <li>
                      <b>{m.target}</b> {m.name}
                      <VRef id={m.v} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ol>

    <More summary="Cronograma completo" meta="ações e entregáveis por trimestre">
      <RoadmapDetails />
    </More>
  </div>
</section>

<style>
  .tl {
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    margin-bottom: 0.6rem;
  }
  /* Trilho: base cinza + progresso verde (desenhado uma vez) */
  .tl::before,
  .tl::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--p-line-strong);
  }
  .tl::after {
    background: var(--p-green);
    transform-origin: left;
  }
  @media (min-width: 760px) {
    .tl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tl__q {
    position: relative;
    padding: 1.4rem 1.4rem 1rem 0;
  }
  /* Nó da timeline */
  .tl__q::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--p-offwhite);
    border: 2.5px solid var(--p-green-dark);
  }
  .tl__q:last-child::before {
    background: var(--p-green-dark);
  }
  .tl__q::before {
    z-index: 1;
  }
  .tl__when {
    font-size: 0.8rem;
    color: var(--p-gray);
  }
  .tl__when b {
    margin-right: 0.2rem;
    color: var(--p-green-dark);
  }
  .tl__v {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
    font-size: clamp(2.4rem, 1.9rem + 2vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .tl__q h3 {
    margin-top: 0.4rem;
    font-size: var(--step-0);
    color: var(--p-graphite);
  }
  .tl__q ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    margin-top: 0.55rem;
  }
  .tl__q ul li {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--p-gray);
  }
  .tl__q ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 1px;
    background: var(--p-green-mid);
  }
  /* Marcos de junho dentro do Q2 */
  .tl__june {
    margin-top: 0.8rem;
    padding: 0.7rem 0.8rem;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--p-line);
  }
  .tl__june .p-label {
    margin-bottom: 0.35rem;
    color: var(--p-green-text);
  }
  .tl__q .tl__june ul {
    margin-top: 0;
    gap: 0.25rem;
  }
  .tl__q .tl__june li {
    display: block;
    padding-left: 0;
    color: var(--p-graphite);
  }
  .tl__june li :global(.vref) {
    margin-left: 0.1rem;
  }
  .tl__q .tl__june li::before {
    content: none;
  }
  .tl__june b {
    color: var(--p-green-dark);
  }
  @media (max-width: 759px) {
    .tl::before,
    .tl::after {
      right: auto;
      bottom: 0;
      width: 2px;
      height: auto;
    }
    .tl::after {
      transform-origin: top;
    }
    .tl__q {
      padding: 1.1rem 0 1rem 1.4rem;
    }
    .tl__q::before {
      top: 1.2rem;
      left: -5px;
    }
  }

  /* ---------- Movimento ----------
     O trilho avança de Q1 a Q4 e cada trimestre acende quando ele chega. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .tl::after {
      transform: scaleX(0);
      transition: transform 1100ms var(--m-ease) 100ms;
    }
    :global(.m-on) .tl__q::before {
      opacity: 0;
      transform: scale(0.6);
      transition: opacity 250ms var(--m-ease), transform 250ms var(--m-ease);
      transition-delay: calc(100ms + var(--i) * 260ms);
    }
    :global(.m-on) .tl__q > * {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
      transition: opacity var(--m-in) var(--m-ease), transform var(--m-in) var(--m-ease);
      transition-delay: calc(180ms + var(--i) * 260ms);
    }
    :global(.m-on) .tl.is-visible::after,
    :global(.m-on) .tl.is-visible .tl__q::before,
    :global(.m-on) .tl.is-visible .tl__q > * {
      opacity: 1;
      transform: none;
    }
  }
  @media screen and (max-width: 759px) and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .tl::after {
      transform: scaleY(0);
    }
  }
  @media print {
    .tl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      break-inside: avoid;
    }
    /* Trilho sempre horizontal no PDF */
    .tl::before,
    .tl::after {
      right: 0;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .tl__q {
      padding: 1.2rem 0.9rem 0.6rem 0;
    }
    .tl__q::before {
      top: -5px;
      left: 0;
    }
    .tl__june {
      padding: 2mm;
    }
    .tl__q .tl__june li {
      display: block;
      font-size: 7.5pt;
    }
  }
</style>
