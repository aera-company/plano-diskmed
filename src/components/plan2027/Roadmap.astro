---
// Bloco 06 · Roadmap (V04) — uma única timeline com quatro trimestres:
// marco acumulado, título e até três entregáveis. O cronograma completo
// (todas as ações e entregáveis) fica no painel expansível / anexo.
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import RoadmapDetails from "./details/RoadmapDetails.astro";
import { quarters } from "../../data/plan2027";

const SHOW = 3;
---

<section id="roadmap" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="06"
      eyebrow="Roadmap 2027"
      title="Quatro trimestres até +15%."
      lead="Marcos de crescimento acumulado propostos, sobre a base 2026 a validar."
      split
    />

    <ol class="tl">
      {
        quarters.map((q) => (
          <li class="tl__q">
            <p class="tl__when">
              <b>{q.q}</b> {q.months}
            </p>
            <p class="tl__v">
              +{q.milestone}%
              {q.q === "Q4" && <VRef id="V1" />}
            </p>
            <h3>{q.theme}</h3>
            <ul>
              {q.deliverables.slice(0, SHOW).map((d) => (
                <li>
                  {d.text} {d.v && <VRef id={d.v} />}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <More summary="Cronograma completo" meta="ações e entregáveis por trimestre">
      <RoadmapDetails />
    </More>
  </div>
</section>

<style>
  .tl {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    margin-bottom: 0.6rem;
  }
  @media (min-width: 760px) {
    .tl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tl__q {
    position: relative;
    padding: 1.4rem 1.4rem 1rem 0;
    border-top: 2px solid var(--p-line-strong);
  }
  /* Nó da timeline */
  .tl__q::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--p-offwhite);
    border: 2.5px solid var(--p-green-dark);
  }
  .tl__q:last-child::before {
    background: var(--p-green-dark);
  }
  .tl__q:first-child {
    border-top-color: var(--p-green);
  }
  .tl__when {
    font-size: 0.8rem;
    color: var(--p-gray);
  }
  .tl__when b {
    margin-right: 0.2rem;
    color: var(--p-green-dark);
  }
  .tl__v {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
    font-size: clamp(2.4rem, 1.9rem + 2vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .tl__q h3 {
    margin-top: 0.4rem;
    font-size: var(--step-0);
    color: var(--p-graphite);
  }
  .tl__q ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    margin-top: 0.55rem;
  }
  .tl__q ul li {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--p-gray);
  }
  .tl__q ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 1px;
    background: var(--p-green-mid);
  }
  @media (max-width: 759px) {
    .tl__q {
      padding: 1.1rem 0 1rem 1.4rem;
      border-top: 0;
      border-left: 2px solid var(--p-line-strong);
    }
    .tl__q::before {
      top: 1.2rem;
      left: -7px;
    }
  }
  @media print {
    .tl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
