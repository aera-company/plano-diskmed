---
import SectionHead from "./SectionHead.astro";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import VRef from "./VRef.astro";
import {
  onboardingOnline,
  onboardingField,
  fieldChecklist,
  onboardingHypotheses,
} from "../../data/plan2027";
---

<section id="onboarding" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="06"
      eyebrow="Onboarding"
      title="5 dias online + 3 dias de campo."
      lead="Formação estruturada para que o novo representante chegue ao cliente com política, portfólio, cadastro e abordagem dominados."
      split
    />

    <div class="ob">
      <article class="p-card ob__phase" data-reveal>
        <header class="ob__phase-head">
          <span class="ob__tag">Fase 1</span>
          <h3>Semana online</h3>
          <p>5 dias</p>
        </header>
        <ol class="ob__tl">
          {
            onboardingOnline.map((d) => (
              <li>
                <span class="ob__day">{d.day}</span>
                <p>{d.text}</p>
              </li>
            ))
          }
        </ol>
      </article>

      <aside class="ob__gate p-avoid-break" data-reveal style="--reveal-delay:100ms" aria-labelledby="ob-gate">
        <span class="ob__gate-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
        <div class="ob__gate-card">
          <h3 id="ob-gate">Checklist de entrada em campo</h3>
          <VRef id="V10" label="Critérios propostos" />
          <ul>
            {
              fieldChecklist.map((c) => (
                <li>
                  <span aria-hidden="true"><Icon name="check" size={14} /></span>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
        <span class="ob__gate-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
      </aside>

      <article class="p-card ob__phase ob__phase--field" data-reveal style="--reveal-delay:180ms">
        <header class="ob__phase-head">
          <span class="ob__tag">Fase 2</span>
          <h3>Imersão presencial com padrinho</h3>
          <p>3 dias consecutivos</p>
        </header>
        <ol class="ob__tl ob__tl--field">
          {
            onboardingField.map((d, i) => (
              <li>
                <span class="ob__day">{d.day}</span>
                <strong class="ob__verb">{d.verb}</strong>
                <p>{d.text}</p>
                <span class="ob__meter" aria-hidden="true">
                  {[0, 1, 2].map((k) => <i class:list={{ on: k <= i }} />)}
                </span>
              </li>
            ))
          }
        </ol>
      </article>
    </div>

    <div class="ob__hyp p-avoid-break" data-reveal>
      <div class="ob__hyp-head">
        <h3>Resultados esperados</h3>
        <Badge status="hipotese" label="Hipóteses · não medidos" />
      </div>
      <ul>
        {onboardingHypotheses.map((h) => <li>{h}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .ob {
    display: grid;
    gap: 1rem;
    align-items: stretch;
  }
  @media (min-width: 1100px) {
    .ob {
      grid-template-columns: 1.1fr 0.75fr 0.95fr;
      gap: 0;
    }
  }
  .ob__phase-head {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 1.2rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--p-line);
  }
  .ob__tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-green-mid);
  }
  .ob__phase-head h3 {
    font-size: var(--step-1);
    color: var(--p-green-dark);
  }
  .ob__phase-head p {
    font-size: var(--step--1);
    color: var(--p-gray);
  }
  .ob__phase--field {
    background: var(--p-green-dark);
    border-color: var(--p-green-dark);
    color: rgba(255, 255, 255, 0.82);
  }
  .ob__phase--field .ob__phase-head {
    border-color: rgba(255, 255, 255, 0.14);
  }
  .ob__phase--field .ob__tag {
    color: var(--p-green);
  }
  .ob__phase--field .ob__phase-head h3 {
    color: #fff;
  }
  .ob__phase--field .ob__phase-head p {
    color: rgba(255, 255, 255, 0.6);
  }

  .ob__tl {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .ob__tl li {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 0 0.85rem 1.4rem;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .ob__tl li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--p-green);
    box-shadow: 0 0 0 4px var(--p-soft);
  }
  .ob__tl li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 1.85rem;
    bottom: -0.3rem;
    width: 1px;
    background: var(--p-line-strong);
  }
  .ob__day {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--p-green-mid);
  }
  .ob__tl--field li::before {
    box-shadow: 0 0 0 4px rgba(141, 198, 63, 0.18);
  }
  .ob__tl--field li:not(:last-child)::after {
    background: rgba(255, 255, 255, 0.18);
  }
  .ob__tl--field .ob__day {
    color: var(--p-green);
  }
  .ob__verb {
    font-size: var(--step-1);
    color: #fff;
    letter-spacing: -0.02em;
  }
  .ob__meter {
    display: flex;
    gap: 4px;
    margin-top: 0.3rem;
  }
  .ob__meter i {
    width: 22px;
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.16);
  }
  .ob__meter i.on {
    background: var(--p-green);
  }

  .ob__gate {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.6rem;
  }
  @media (min-width: 1100px) {
    .ob__gate {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.5rem;
      padding-inline: 0.5rem;
    }
  }
  .ob__gate-arrow {
    color: var(--p-green);
    transform: rotate(90deg);
  }
  @media (min-width: 1100px) {
    .ob__gate-arrow {
      transform: none;
    }
  }
  .ob__gate-card {
    width: 100%;
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    padding: 1.3rem;
    border-radius: 14px;
    border: 1.5px dashed rgba(233, 167, 58, 0.6);
    background: #fffdf8;
  }
  .ob__gate-card h3 {
    font-size: var(--step-0);
    color: var(--p-graphite);
  }
  .ob__gate-card ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .ob__gate-card li {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.45rem;
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--p-graphite);
  }
  .ob__gate-card li span {
    display: inline-grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.05rem;
    border-radius: 4px;
    border: 1px solid var(--p-line-strong);
    color: var(--p-green-mid);
  }

  .ob__hyp {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 1rem;
    padding: 1.4rem 1.6rem;
    border-radius: 16px;
    border: 1px solid var(--p-line);
    background: var(--p-offwhite);
  }
  @media (min-width: 900px) {
    .ob__hyp {
      grid-template-columns: 16rem 1fr;
      align-items: center;
    }
  }
  .ob__hyp-head {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .ob__hyp-head h3 {
    font-size: var(--step-1);
    color: var(--p-green-dark);
  }
  .ob__hyp ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 720px) {
    .ob__hyp ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .ob__hyp li {
    padding-left: 0.9rem;
    border-left: 2px solid var(--p-line-strong);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--p-graphite);
  }
</style>
