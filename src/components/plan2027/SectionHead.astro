---
interface Props {
  num: string;
  eyebrow: string;
  title: string;
  lead?: string;
  /** Título à esquerda e lead à direita no desktop. */
  split?: boolean;
}

const { num, eyebrow, title, lead, split = false } = Astro.props;
---

<header class:list={["sh", { "sh--split": split }]}>
  <div>
    <p class="eyebrow eyebrow--line" data-num={num} data-reveal>{eyebrow}</p>
    <h2 class="sh__title" data-reveal style="--reveal-delay:60ms">{title}</h2>
  </div>
  {
    (lead || Astro.slots.has("default")) && (
      <div data-reveal style="--reveal-delay:120ms">
        {lead && <p class="sh__lead">{lead}</p>}
        <slot />
      </div>
    )
  }
</header>
