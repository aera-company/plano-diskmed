---
import Icon from "./Icon.astro";
import { navLinks, agenda, validations } from "../../data/plan2027";

const open = validations.filter((v) => v.status !== "Validado").length;
---

<header class="p-nav" data-nav>
  <div class="p-nav__inner container container-wide">
    <a class="p-nav__logo" href="#abertura" aria-label="DiskMed Pádua — início do plano">
      <img
        src="/images/logo-diskmed.png"
        alt="DiskMed Pádua"
        width="600"
        height="171"
        decoding="async"
      />
    </a>
    <nav class="p-nav__links" aria-label="Navegação do plano">
      {navLinks.map((l) => <a href={l.href} data-spy={l.href.slice(1)}>{l.label}</a>)}
      <a href="#decisoes" class="p-nav__decisions" data-spy="decisoes">
        Decisões
        {open > 0 && <span class="p-nav__count" aria-label={`${open} pendentes`}>{open}</span>}
      </a>
    </nav>
    <button type="button" class="p-nav__print" data-print aria-label="Exportar ou imprimir PDF">
      <Icon name="print" size={18} />
      <span>Exportar PDF</span>
    </button>
  </div>
  <div class="p-nav__progress" data-progress aria-hidden="true"></div>
</header>

<!-- Trilho lateral de seções (desktop largo) -->
<nav class="p-rail" aria-label="Seções do plano">
  <ol>
    {
      agenda.map((a) => (
        <li>
          <a href={`#${a.id}`} data-rail={a.id}>
            <span class="p-rail__num">{a.num}</span>
            <span class="p-rail__label">{a.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .p-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .p-nav[data-scrolled] {
    border-bottom-color: var(--p-line);
  }
  .p-nav__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    min-height: 68px;
  }
  .p-nav__logo img {
    height: 36px;
    width: auto;
  }
  .p-nav__links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    font-size: var(--step--1);
    color: var(--p-gray);
  }
  .p-nav__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.4rem;
    transition: color 0.2s var(--ease);
  }
  .p-nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--p-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .p-nav__links a:hover,
  .p-nav__links a:focus-visible,
  .p-nav__links a[aria-current="true"] {
    color: var(--p-green-dark);
  }
  .p-nav__links a:hover::after,
  .p-nav__links a:focus-visible::after,
  .p-nav__links a[aria-current="true"]::after {
    transform: scaleX(1);
  }
  .p-nav__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding-inline: 0.3rem;
    border-radius: 100px;
    background: var(--p-amber-bg);
    color: var(--p-amber-ink);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .p-nav__print {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--p-line-strong);
    border-radius: 100px;
    background: #fff;
    color: var(--p-green-dark);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .p-nav__print:hover {
    border-color: var(--p-green-mid);
    background: var(--p-soft);
  }
  .p-nav__progress {
    height: 2px;
    width: var(--p, 0%);
    background: var(--p-green);
  }

  @media (max-width: 860px) {
    .p-nav__inner {
      grid-template-columns: 1fr auto;
      row-gap: 0;
      padding-top: 0.5rem;
    }
    .p-nav__print {
      justify-self: end;
      padding: 0.55rem;
    }
    .p-nav__print span {
      display: none;
    }
    .p-nav__logo img {
      height: 30px;
    }
    /* Links viram uma faixa rolável abaixo da marca, sem overflow da página */
    .p-nav__links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      gap: 1.4rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-block: 0.35rem 0.55rem;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .p-nav__links::-webkit-scrollbar {
      display: none;
    }
    .p-nav__links a {
      white-space: nowrap;
    }
    /* No mobile a barra de progresso ficaria colada ao sublinhado ativo */
    .p-nav__progress {
      display: none;
    }
  }

  /* ---------- Trilho lateral ---------- */
  .p-rail {
    display: none;
  }
  @media (min-width: 1360px) {
    .p-rail {
      display: block;
      position: fixed;
      z-index: 90;
      left: max(0.75rem, calc((100vw - 1320px) / 2 - 3.25rem));
      top: 50%;
      transform: translateY(-50%);
    }
  }
  .p-rail ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .p-rail a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.3rem 0;
    color: var(--p-gray);
  }
  .p-rail__num {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
    transition: opacity 0.2s var(--ease), color 0.2s var(--ease);
  }
  .p-rail a::before {
    content: "";
    width: 10px;
    height: 1px;
    margin-right: 0.5rem;
    background: currentColor;
    opacity: 0.35;
    transition: width 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  .p-rail__label {
    position: absolute;
    left: calc(100% + 0.6rem);
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: var(--p-graphite);
    color: #fff;
    font-size: 0.72rem;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    pointer-events: none;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .p-rail a:hover .p-rail__label,
  .p-rail a:focus-visible .p-rail__label {
    opacity: 1;
    transform: none;
  }
  .p-rail a:hover .p-rail__num,
  .p-rail a[aria-current="true"] .p-rail__num {
    opacity: 1;
  }
  .p-rail a[aria-current="true"] {
    color: var(--p-green-mid);
  }
  .p-rail a[aria-current="true"]::before {
    width: 22px;
    opacity: 1;
    background: var(--p-green);
  }
  /* Sobre seções escuras, o trilho clareia */
  .p-rail[data-on-dark] a {
    color: rgba(255, 255, 255, 0.7);
  }
  .p-rail[data-on-dark] a[aria-current="true"] {
    color: #fff;
  }
</style>
