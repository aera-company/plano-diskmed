---
// Bloco 02 · Diagnóstico — seis problemas em três categorias e o gargalo
// crítico NC/Multilab em uma única linha. Ação, responsável, prazo e
// indicador ficam no detalhe expansível de cada problema.
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import More from "./More.astro";
import Icon from "./Icon.astro";
import { diagnostics, diagnosticCategories, bottleneck } from "../../data/plan2027";

const groups = diagnosticCategories
  .map((c) => ({ ...c, rows: diagnostics.filter((d) => d.category === c.key) }))
  .filter((g) => g.rows.length);
const critical = diagnostics.find((d) => d.priority === "Crítica");
---

<section id="diagnostico" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="02"
      eyebrow="Diagnóstico"
      title="Onde o crescimento está sendo limitado."
      lead="Seis problemas em três frentes. Cada um já tem ação, responsável e prazo propostos."
      split
    />

    <div class="dg">
      {
        groups.map((g, gi) => (
          <section class={`dg__col dg__col--${g.key}`} aria-labelledby={`dg-${g.key}`} data-reveal style={`--reveal-delay:${gi * 60}ms`}>
            <header class="dg__head">
              <span class="dg__count">{g.rows.length}</span>
              <div>
                <h3 id={`dg-${g.key}`}>{g.title}</h3>
                <p>{g.text}</p>
              </div>
            </header>
            <ol class="dg__list">
              {g.rows.map((d) => (
                <li id={d.id.toLowerCase()} class:list={["dg__item", { "dg__item--crit": d.priority === "Crítica" }]}>
                  <p class="dg__meta">
                    <span class="dg__id">{d.id}</span>
                    <span class:list={["prio", d.priority === "Crítica" ? "prio--critica" : "prio--alta"]}>{d.priority}</span>
                  </p>
                  <h4 class="dg__problem">{d.problem}</h4>
                  <p class="dg__impact">{d.impact}</p>
                  <More summary="Ação e responsável">
                    <dl class="p-dl">
                      <div><dt>Ação</dt><dd>{d.action}</dd></div>
                      <div><dt>Responsável</dt><dd>{d.owners}</dd></div>
                      <div><dt>Prazo</dt><dd>{d.deadline} {d.v && <VRef id={d.v} />}</dd></div>
                      <div><dt>Indicador</dt><dd>{d.indicator}</dd></div>
                    </dl>
                  </More>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <!-- Gargalo crítico NC/Multilab: uma linha visual -->
    <figure class="bn p-avoid-break" data-reveal aria-labelledby="bn-title">
      <figcaption class="bn__cap">
        <span class="bn__tag">{critical?.id} · Crítica</span>
        <strong id="bn-title">Grupo NC / Multilab: o pedido sai, mas não chega ao faturamento.</strong>
      </figcaption>
      <ol class="bn__flow">
        {
          bottleneck.steps.map((s) => (
            <li class={`bn__step bn__step--${s.state}`}>
              <span class="bn__node" aria-hidden="true">
                {s.state === "ok" && <Icon name="check" size={14} />}
                {s.state === "break" && <Icon name="alert" size={14} />}
              </span>
              <span class="bn__label">{s.label}</span>
            </li>
          ))
        }
      </ol>
      <p class="bn__controls">
        <span>{bottleneck.controls.join(" · ")}</span>
        <em>{bottleneck.status}</em>
      </p>
    </figure>

    <p class="dg__note">
      Prioridades, responsáveis e prazos são propostos pela Coordenação Comercial <VRef id="V10" />. Nenhum valor
      de perda ou recuperação foi estimado.
    </p>
  </div>
</section>

<style>
  .dg {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 960px) {
    .dg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .dg__col {
    --tone: var(--p-green-dark);
    display: flex;
    flex-direction: column;
    border-top: 3px solid var(--tone);
  }
  .dg__col--cobertura {
    --tone: var(--p-green-mid);
  }
  .dg__col--operacao {
    --tone: #7aa857;
  }
  .dg__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0 0.9rem;
  }
  .dg__count {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--tone);
  }
  .dg__head h3 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    color: var(--p-green-dark);
  }
  .dg__head p {
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--p-gray);
  }
  .dg__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .dg__item {
    padding: 1.1rem 1.2rem 0.2rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--p-line);
    scroll-margin-top: 110px;
  }
  .dg__item--crit {
    border-color: rgba(196, 85, 59, 0.45);
    box-shadow: inset 3px 0 0 var(--p-red);
  }
  .dg__item:target {
    animation: dgFlash 1.6s var(--ease);
  }
  @keyframes dgFlash {
    0%,
    30% {
      background: #eef6e6;
    }
  }
  .dg__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .dg__id {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--p-green-text);
  }
  .dg__problem {
    margin-top: 0.45rem;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--p-graphite);
  }
  .dg__impact {
    margin: 0.35rem 0 0.8rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--p-gray);
  }
  .dg__item :global(.more__body) {
    font-size: 0.86rem;
  }
  .dg__item :global(.p-dl > div) {
    grid-template-columns: 1fr;
  }

  /* ---------- NC / Multilab ---------- */
  .bn {
    display: grid;
    gap: 1.1rem 2rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    padding: clamp(1.2rem, 2.4vw, 1.6rem) clamp(1.2rem, 2.6vw, 1.9rem);
    border-radius: 16px;
    background: var(--p-green-dark);
    color: rgba(255, 255, 255, 0.86);
  }
  @media (min-width: 1100px) {
    .bn {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: center;
    }
    .bn__controls {
      grid-column: 1 / -1;
    }
  }
  .bn__cap {
    display: grid;
    gap: 0.35rem;
  }
  .bn__tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f4a08b;
  }
  .bn__cap strong {
    font-size: var(--step-0);
    line-height: 1.3;
    color: #fff;
  }
  .bn__flow {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .bn__step {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .bn__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 0.85rem;
    left: calc(50% + 1rem);
    right: calc(-50% + 1rem);
    height: 2px;
    background: var(--p-green);
  }
  .bn__step--break::after,
  .bn__step--action::after {
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.45) 0 5px, transparent 5px 10px) !important;
  }
  .bn__node {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
  }
  .bn__step--ok .bn__node {
    background: var(--p-green);
    color: var(--p-green-ink);
  }
  .bn__step--break .bn__node {
    background: #f07a5f;
    color: #3a0d05;
    box-shadow: 0 0 0 5px rgba(240, 122, 95, 0.2);
  }
  .bn__step--action .bn__node {
    border: 2px solid var(--p-amber);
  }
  .bn__step--target .bn__node {
    border: 2px dashed rgba(255, 255, 255, 0.55);
  }
  .bn__label {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
    color: #fff;
  }
  .bn__step--break .bn__label {
    color: #f4a08b;
  }
  .bn__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.82rem;
  }
  .bn__controls span {
    font-weight: 600;
    color: var(--p-green);
  }
  .bn__controls em {
    font-style: normal;
    color: rgba(255, 255, 255, 0.62);
  }
  @media (max-width: 560px) {
    .bn__label {
      font-size: 0.68rem;
    }
  }

  @media print {
    .dg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4mm;
    }
    .dg__item {
      padding: 3mm 3mm 0;
    }
    .dg__problem {
      font-size: 9.5pt;
    }
    .dg__impact,
    .dg__item :global(.more__body) {
      font-size: 8pt;
    }
    .bn {
      grid-template-columns: 1fr;
    }
  }
  .dg__note {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--p-gray);
  }
</style>
