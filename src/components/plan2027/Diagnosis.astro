---
// Bloco 02 · Diagnóstico (V04) — seis problemas em duas linhas cada
// (problema · ação principal), o fluxo NC/Multilab em uma linha compacta e
// os detalhes técnicos em uma única área expansível.
import SectionHead from "./SectionHead.astro";
import More from "./More.astro";
import DiagDetails from "./details/DiagDetails.astro";
import { diagnostics, diagnosticCategories, bottleneck } from "../../data/plan2027";

const groups = diagnosticCategories
  .map((c) => ({ ...c, rows: diagnostics.filter((d) => d.category === c.key) }))
  .filter((g) => g.rows.length);
---

<section id="diagnostico" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="02"
      eyebrow="Diagnóstico"
      title="Onde o crescimento está sendo limitado."
      lead="Seis problemas em três frentes, cada um com a ação que o resolve."
      split
    />

    <div class="dg">
      {
        groups.map((g) => (
          <section class={`dg__col dg__col--${g.key}`} aria-labelledby={`dg-${g.key}`}>
            <h3 id={`dg-${g.key}`} class="dg__cat">{g.title}</h3>
            <ol class="dg__list">
              {g.rows.map((d) => (
                <li class:list={{ "dg__item--crit": d.priority === "Crítica" }}>
                  <p class="dg__problem">
                    {d.short.problem}
                    {d.priority === "Crítica" && <span class="dg__crit">Crítica</span>}
                  </p>
                  <p class="dg__action">{d.short.action}</p>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <!-- NC / Multilab em uma linha -->
    <figure class="bn" aria-label="Fluxo do pedido Grupo NC / Multilab">
      <figcaption>NC / Multilab</figcaption>
      <ol class="bn__flow">
        {bottleneck.steps.map((s) => <li class={`bn__step bn__step--${s.state}`}>{s.label}</li>)}
      </ol>
      <span class="bn__status">{bottleneck.status}</span>
    </figure>

    <More summary="Detalhes técnicos do diagnóstico" meta="impacto, responsável, prazo e indicador">
      <DiagDetails />
    </More>
  </div>
</section>

<style>
  .dg {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
  }
  @media (min-width: 900px) {
    .dg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .dg__col {
    --tone: var(--p-green-dark);
    border-top: 3px solid var(--tone);
  }
  .dg__col--cobertura {
    --tone: var(--p-green-mid);
  }
  .dg__col--operacao {
    --tone: #7aa857;
  }
  .dg__cat {
    padding: 0.7rem 0 0.2rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-green-dark);
  }
  .dg__list {
    list-style: none;
    padding: 0;
  }
  .dg__list li {
    padding: 0.6rem 0;
  }
  .dg__list li + li {
    border-top: 1px solid var(--p-line-strong);
  }
  .dg__problem {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--p-graphite);
  }
  .dg__crit {
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border-radius: 5px;
    background: var(--p-red-bg);
    color: var(--p-red-ink);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 0.15em;
  }
  .dg__action {
    margin-top: 0.15rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--p-gray);
  }
  .dg__action::before {
    content: "→ ";
    color: var(--p-green-text);
    font-weight: 700;
  }

  /* ---------- NC / Multilab: linha compacta ---------- */
  .bn {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
    margin: 1.4rem 0 0.4rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--p-green-dark);
    color: #fff;
  }
  .bn figcaption {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f4a08b;
  }
  .bn__flow {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .bn__step {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .bn__step + .bn__step::before {
    content: "";
    width: 18px;
    height: 2px;
    background: var(--p-green);
  }
  .bn__step--break,
  .bn__step--action,
  .bn__step--target {
    color: rgba(255, 255, 255, 0.8);
  }
  .bn__step--break {
    color: #f4a08b;
  }
  .bn__step--break::before,
  .bn__step--action::before,
  .bn__step--target::before {
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 4px, transparent 4px 7px) !important;
  }
  .bn__step--break::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f07a5f;
    box-shadow: 0 0 0 4px rgba(240, 122, 95, 0.25);
    order: -1;
  }
  .bn__step--break::before {
    order: -2;
  }
  .bn__status {
    margin-left: auto;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.62);
  }
  @media (max-width: 640px) {
    .bn__status {
      margin-left: 0;
    }
  }
  @media print {
    .dg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
