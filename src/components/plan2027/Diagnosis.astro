---
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import { diagnostics, diagnosticCategories } from "../../data/plan2027";

const groups = diagnosticCategories
  .map((c) => ({ ...c, rows: diagnostics.filter((d) => d.category === c.key) }))
  .filter((g) => g.rows.length);
const total = diagnostics.length;
const columns = ["Problema", "Impacto", "Ação", "Responsável", "Prazo", "Indicador"];
---

<section id="diagnostico" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="01"
      eyebrow="Diagnóstico"
      title="Onde o crescimento está sendo limitado."
      lead="Seis restrições identificadas pela Coordenação Comercial. Cada uma já aponta a decisão: ação, responsável, prazo e indicador de acompanhamento."
      split
    />

    <!-- Distribuição das restrições por natureza do impacto (contagem factual) -->
    <div class="dg-dist" data-reveal aria-label="Distribuição das restrições por natureza do impacto">
      <div class="dg-dist__bar" aria-hidden="true">
        {groups.map((g) => <span class={`dg-dist__seg dg-dist__seg--${g.key}`} style={`flex:${g.rows.length}`} />)}
      </div>
      <ul class="dg-dist__legend">
        {
          groups.map((g) => (
            <li class={`dg-dist__item dg-dist__item--${g.key}`}>
              <b>{g.rows.length}</b>
              <span>{g.title}</span>
            </li>
          ))
        }
      </ul>
      <p class="dg-dist__total">{total} restrições</p>
    </div>

    <div class="p-table-wrap" data-reveal>
      <table class="p-table dm">
        <caption>
          Matriz de decisão. Prazos e indicadores propostos a partir do roadmap e da governança <VRef id="V10" />
        </caption>
        <thead>
          <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
        </thead>
        {
          groups.map((g, gi) => (
            <tbody class={`dm__group dm__group--${g.key}`}>
              <tr class="dm__ghead">
                <th colspan={columns.length} scope="rowgroup">
                  <span class="dm__gnum">{String(gi + 1).padStart(2, "0")}</span>
                  <span class="dm__gtitle">{g.title}</span>
                  <span class="dm__gtext">{g.text}</span>
                  {g.key === "receita" && <span class="dm__flag">Impacto direto na receita</span>}
                </th>
              </tr>
              {g.rows.map((d) => (
                <tr id={d.id.toLowerCase()} class:list={{ "dm__row--crit": d.priority === "Crítica" }}>
                  <th scope="row">
                    <span class="dm__id">{d.id}</span>
                    <span class="dm__problem">{d.problem}</span>
                    <span class:list={["prio", d.priority === "Crítica" ? "prio--critica" : "prio--alta"]}>
                      {d.priority}
                    </span>
                  </th>
                  <td data-label="Impacto">{d.impact}</td>
                  <td data-label="Ação">{d.action}</td>
                  <td data-label="Responsável" class="dm__owner">{d.owners.replaceAll("/", "/​")}</td>
                  <td data-label="Prazo" class="dm__deadline">
                    {d.deadline}
                    {d.v && <VRef id={d.v} />}
                  </td>
                  <td data-label="Indicador" class="dm__ind">{d.indicator}</td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>

    <p class="dg-note" data-reveal>
      Prioridade e responsáveis são recomendações da Coordenação Comercial. Nenhum valor de perda ou de
      recuperação foi estimado: a dimensão financeira de cada restrição depende da apuração da base.
    </p>
  </div>
</section>

<style>
  /* ---------- Distribuição ---------- */
  .dg-dist {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  @media (min-width: 960px) {
    .dg-dist {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 2rem;
    }
    .dg-dist__bar {
      grid-column: 1 / -1;
    }
  }
  .dg-dist__bar {
    display: flex;
    gap: 4px;
    height: 10px;
  }
  .dg-dist__seg {
    border-radius: 4px;
  }
  .dg-dist__seg--receita,
  .dg-dist__item--receita b {
    background: var(--p-green-dark);
  }
  .dg-dist__seg--expansao,
  .dg-dist__item--expansao b {
    background: var(--p-green-mid);
  }
  .dg-dist__seg--eficiencia,
  .dg-dist__item--eficiencia b {
    background: #7aa857;
  }
  .dg-dist__seg--equipe,
  .dg-dist__item--equipe b {
    background: #a9c98f;
  }
  .dg-dist__legend {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
  }
  .dg-dist__item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--p-graphite);
  }
  .dg-dist__item b {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    color: #fff;
    font-size: 0.75rem;
  }
  .dg-dist__item--equipe b {
    color: var(--p-green-ink);
  }
  .dg-dist__total {
    font-size: var(--step--1);
    color: var(--p-gray);
  }

  /* ---------- Matriz de decisão ---------- */
  .dm {
    table-layout: fixed;
  }
  .dm tr[id] {
    scroll-margin-top: 96px;
  }
  .dm tr[id]:target > * {
    animation: dmFlash 1.6s var(--ease);
  }
  @keyframes dmFlash {
    0%,
    30% {
      background: #e6f2d9;
    }
  }
  .dm thead th:nth-child(1) {
    width: 21%;
  }
  .dm thead th:nth-child(2) {
    width: 19%;
  }
  .dm thead th:nth-child(3) {
    width: 19%;
  }
  .dm thead th:nth-child(4) {
    width: 13%;
  }
  .dm thead th:nth-child(5) {
    width: 12%;
  }
  /* Setas no cabeçalho: a leitura é uma cadeia de decisão */
  .dm thead th:not(:last-child)::after {
    content: "→";
    margin-left: 0.4rem;
    color: var(--p-green-text);
    font-weight: 700;
  }
  .dm__ghead th {
    padding-top: 1.4rem;
    padding-bottom: 0.7rem;
    background: #fff;
    border-bottom: 1px solid var(--p-line);
  }
  .dm__group + .dm__group .dm__ghead th {
    border-top: 1px solid var(--p-line-strong);
  }
  .dm__gnum {
    margin-right: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--p-green-text);
  }
  .dm__gtitle {
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--p-green-dark);
    letter-spacing: -0.01em;
  }
  .dm__gtext {
    margin-left: 0.7rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--p-gray);
  }
  .dm__flag {
    float: right;
    padding: 0.22rem 0.6rem;
    border-radius: 100px;
    background: var(--p-green-dark);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Recuperação imediata de receita: prioridade visual */
  .dm__group--receita tr:not(.dm__ghead) > * {
    background: #f6faf1;
  }
  .dm__group--receita tr:not(.dm__ghead) th[scope="row"] {
    box-shadow: inset 3px 0 0 var(--p-green-dark);
  }
  .dm__row--crit th[scope="row"] {
    box-shadow: inset 3px 0 0 var(--p-red) !important;
  }
  .dm th[scope="row"] {
    display: table-cell;
  }
  .dm__id {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--p-green-text);
    margin-bottom: 0.2rem;
  }
  .dm__problem {
    display: block;
    font-weight: 600;
    color: var(--p-graphite);
    line-height: 1.4;
  }
  .dm th[scope="row"] .prio {
    margin-top: 0.6rem;
  }
  .dm__owner {
    font-weight: 600;
    color: var(--p-green-dark);
  }
  .dm__deadline {
    color: var(--p-graphite);
  }
  .dm__deadline :global(.vref) {
    margin-top: 0.4rem;
  }
  .dm__ind {
    color: var(--p-gray);
  }
  .dm caption :global(.vref) {
    margin-left: 0.35rem;
  }
  .dg-note {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--p-gray);
    max-width: 90ch;
  }

  /* Impressão: setas fora e colunas redistribuídas para caber no A4 */
  @media print {
    .dm thead th::after {
      content: none !important;
    }
    .dm thead th {
      letter-spacing: 0.04em !important;
    }
    .dm thead th:nth-child(1) {
      width: 19%;
    }
    .dm thead th:nth-child(2),
    .dm thead th:nth-child(3) {
      width: 17%;
    }
    .dm thead th:nth-child(4) {
      width: 16%;
    }
    .dm thead th:nth-child(5) {
      width: 15%;
    }
    .dm td,
    .dm th {
      overflow-wrap: break-word !important;
      hyphens: auto;
    }
  }

  @media screen and (max-width: 860px) {
    .dm thead th {
      width: auto !important;
    }
    .dm th[scope="row"] {
      display: block;
    }
    .dm__ghead th {
      padding: 1.1rem 1.15rem 0.8rem !important;
      background: var(--p-offwhite);
    }
    .dm__gtext {
      display: block;
      margin: 0.3rem 0 0;
    }
    .dm__flag {
      float: none;
      display: inline-block;
      margin-top: 0.6rem;
    }
    .dm__group--receita tr:not(.dm__ghead) {
      background: #f6faf1;
      box-shadow: inset 3px 0 0 var(--p-green-dark);
    }
    .dm__group--receita tr:not(.dm__ghead) > * {
      background: transparent;
    }
    .dm__group--receita tr:not(.dm__ghead) th[scope="row"],
    .dm__row--crit th[scope="row"] {
      box-shadow: none !important;
    }
    .dm__row--crit {
      box-shadow: inset 3px 0 0 var(--p-red) !important;
    }
    /* Responsável e prazo lado a lado: cartão mais curto */
    .dm .dm__owner,
    .dm .dm__deadline {
      display: inline-block;
      width: 49%;
      vertical-align: top;
      padding-right: 0.6rem;
    }
  }
</style>
