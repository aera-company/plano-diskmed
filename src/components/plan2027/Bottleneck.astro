---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { bottleneck, diagnostics } from "../../data/plan2027";

const issue = diagnostics.find((d) => d.priority === "Crítica");
const breakIndex = bottleneck.steps.findIndex((s) => s.state === "break");
---

<section id="gargalo" class="p-section p-section--dark bn" data-dark>
  <div class="container container-wide">
    <SectionHead
      num="02"
      eyebrow="Destaque · Grupo NC / Multilab"
      title="O pedido sai, mas não chega ao faturamento."
      lead="A restrição crítica do diagnóstico. O fluxo mostra onde a continuidade se perde, quem precisa atuar junto e o que passa a ser medido."
      split
    />

    <p class="bn__status" data-reveal>
      <span aria-hidden="true"></span>{bottleneck.status}
    </p>

    <!-- Fluxo do pedido -->
    <ol class="bn__flow" data-reveal aria-label="Fluxo do pedido Grupo NC / Multilab">
      {
        bottleneck.steps.map((s, i) => (
          <li class:list={["bn__step", `bn__step--${s.state}`, { "bn__step--pre-break": i === breakIndex - 1 }]} style={`--i:${i}`}>
            <span class="bn__node" aria-hidden="true">
              {s.state === "ok" && <Icon name="check" size={18} />}
              {s.state === "break" && <Icon name="alert" size={18} />}
              {s.state === "action" && <span>{i + 1}</span>}
              {s.state === "target" && <span>{i + 1}</span>}
            </span>
            <span class="bn__label">{s.label}</span>
            {s.state === "break" && (
              <span class="bn__rupture">
                <b>Ponto de ruptura</b>
                {bottleneck.rupture}
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <div class="bn__grid">
      <figure class="bn__team p-avoid-break" data-reveal>
        <figcaption>
          <h3>Tratativa integrada</h3>
          <p>{issue?.action}</p>
        </figcaption>
        <div class="bn__converge">
          <ul class="bn__areas">
            {
              bottleneck.areas.map((a) => (
                <li>
                  <strong>{a.name}</strong>
                  <span>{a.role}</span>
                </li>
              ))
            }
          </ul>
          <span class="bn__arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
          <ul class="bn__controls" aria-label="Controles propostos">
            {bottleneck.controls.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </figure>

      <div class="bn__metrics p-avoid-break" data-reveal style="--reveal-delay:100ms">
        <h3>O que passa a ser medido</h3>
        <ul>
          {
            bottleneck.metrics.map((m) => (
              <li>
                <span class="bn__mv" class:list={{ "bn__mv--empty": !m.value }}>
                  {m.value ?? "A medir"}
                </span>
                <span class="bn__ml">
                  <strong>{m.label}</strong>
                  {m.text}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="bn__note">
          Acompanhamento semanal até a estabilização, pelo relatório de pedidos enviados × faturados.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .bn {
    --rupture: #f07a5f;
  }
  .bn__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.86);
  }
  .bn__status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--p-amber);
  }

  /* ---------- Fluxo ---------- */
  .bn__flow {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 900px) {
    .bn__flow {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding-top: 7.5rem;
    }
  }
  .bn__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    align-items: center;
    column-gap: 1rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 900px) {
    .bn__step {
      grid-template-columns: 1fr;
      justify-items: start;
      row-gap: 0.9rem;
      padding-bottom: 0;
      padding-right: 1rem;
    }
  }
  .bn__node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .bn__step--ok .bn__node {
    background: var(--p-green);
    color: var(--p-green-ink);
  }
  .bn__step--break .bn__node {
    background: var(--rupture);
    color: #3a0d05;
    box-shadow: 0 0 0 6px rgba(240, 122, 95, 0.18);
  }
  .bn__step--action .bn__node {
    background: transparent;
    border: 2px solid var(--p-amber);
    color: #f4cf8f;
  }
  .bn__step--target .bn__node {
    background: transparent;
    border: 2px dashed rgba(255, 255, 255, 0.5);
    color: #fff;
  }
  .bn__label {
    font-size: var(--step-0);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .bn__step--break .bn__label {
    color: var(--rupture);
  }

  /* Conectores: vertical no mobile, horizontal no desktop */
  .bn__step:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: 0;
    width: 2px;
    background: var(--p-green);
    transform-origin: top;
  }
  .bn__step--pre-break::after {
    background: linear-gradient(var(--p-green), var(--rupture)) !important;
  }
  .bn__step--break::after {
    background: repeating-linear-gradient(180deg, var(--rupture) 0 5px, transparent 5px 10px) !important;
  }
  .bn__step--action::after {
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0 5px, transparent 5px 10px) !important;
  }
  @media (min-width: 900px) {
    .bn__step:not(:last-child)::after {
      left: 2.75rem;
      right: 0;
      top: calc(1.375rem - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      transform-origin: left;
    }
    .bn__step--pre-break::after {
      background: linear-gradient(90deg, var(--p-green), var(--rupture)) !important;
    }
    .bn__step--break::after {
      background: repeating-linear-gradient(90deg, var(--rupture) 0 6px, transparent 6px 12px) !important;
    }
    .bn__step--action::after {
      background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 6px, transparent 6px 12px) !important;
    }
  }
  /* Entrada coordenada: conectores desenham em sequência */
  .bn__flow .bn__step::after {
    transform: scale(0);
    transition: transform 0.6s var(--ease) calc(0.25s + var(--i) * 0.18s);
  }
  .bn__flow .bn__node {
    opacity: 0;
    transition: opacity 0.4s var(--ease) calc(0.1s + var(--i) * 0.18s);
  }
  .bn__flow.is-visible .bn__step::after {
    transform: none;
  }
  .bn__flow.is-visible .bn__node {
    opacity: 1;
  }

  .bn__rupture {
    grid-column: 2;
    display: grid;
    gap: 0.3rem;
    margin-top: 0.6rem;
    padding: 0.8rem 0.95rem;
    border-radius: 10px;
    background: rgba(240, 122, 95, 0.12);
    border: 1px solid rgba(240, 122, 95, 0.35);
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.86);
  }
  .bn__rupture b {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rupture);
  }
  @media (min-width: 900px) {
    .bn__rupture {
      position: absolute;
      grid-column: auto;
      left: -55%;
      bottom: calc(100% + 1rem);
      width: 210%;
      max-width: 22rem;
      margin: 0;
    }
  }

  /* ---------- Tratativa + métricas ---------- */
  .bn__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 1000px) {
    .bn__grid {
      grid-template-columns: 1.25fr 0.75fr;
    }
  }
  .bn__team,
  .bn__metrics {
    padding: clamp(1.3rem, 2.6vw, 1.9rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
  }
  .bn h3 {
    font-size: var(--step-1);
    color: #fff;
  }
  .bn__team figcaption p {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.7);
    max-width: 60ch;
  }
  .bn__converge {
    display: grid;
    gap: 1rem;
    margin-top: 1.4rem;
    align-items: center;
  }
  @media (min-width: 720px) {
    .bn__converge {
      grid-template-columns: 1.3fr auto 0.9fr;
    }
  }
  .bn__areas {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .bn__areas li {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 0.9rem;
    border-left: 2px solid var(--p-green);
    background: rgba(255, 255, 255, 0.04);
    border-radius: 0 8px 8px 0;
  }
  .bn__areas strong {
    font-size: var(--step--1);
    color: #fff;
  }
  .bn__areas span {
    font-size: 0.8rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.68);
  }
  .bn__arrow {
    justify-self: center;
    color: var(--p-green);
    transform: rotate(90deg);
  }
  @media (min-width: 720px) {
    .bn__arrow {
      transform: none;
    }
  }
  .bn__controls {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .bn__controls li {
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    background: var(--p-green);
    color: var(--p-green-ink);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .bn__metrics ul {
    list-style: none;
    padding: 0;
    display: grid;
    margin-top: 1rem;
  }
  .bn__metrics li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .bn__mv {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--p-green);
  }
  .bn__mv--empty {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #f4cf8f;
  }
  .bn__ml {
    display: grid;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.68);
  }
  .bn__ml strong {
    font-size: var(--step--1);
    color: #fff;
  }
  .bn__note {
    margin-top: 0.8rem;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.66);
  }

  @media print {
    .bn__flow .bn__step::after {
      transform: none;
    }
    .bn__flow .bn__node {
      opacity: 1;
    }
  }
</style>
