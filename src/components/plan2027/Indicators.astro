---
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import { indicators, juneMilestones, routine } from "../../data/plan2027";

const withCurrent = indicators.filter((i) => i.current !== null).length;
const withDeviation = indicators.filter((i) => i.deviation !== null).length;
const summary = [
  { n: indicators.length, label: "metas propostas", tone: "meta" },
  { n: withCurrent, label: "resultados apurados", tone: withCurrent ? "meta" : "empty" },
  { n: withDeviation, label: "desvios calculáveis", tone: withDeviation ? "meta" : "empty" },
];
// Decisões de que o painel depende (sem repetir o mesmo código por linha).
const pendingIds = [...new Set(indicators.map((i) => i.v))];
// Quebra opcional após "/" para metas longas (ex.: representante/mês).
const brk = (s: string) => s.replace("/", "/​");
---

<section id="indicadores" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="08"
      eyebrow="Painel de indicadores"
      title="Metas claras. Resultados quando houver base."
      lead="Painel executivo de acompanhamento. Resultado atual e desvio ficam em branco até a primeira apuração: nenhum valor de desempenho é estimado."
      split
    />

    <ul class="ki__summary" data-reveal aria-label="Situação do painel">
      {
        summary.map((s) => (
          <li class={`ki__sum ki__sum--${s.tone}`}>
            <b>{s.n}</b>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="p-table-wrap" data-reveal>
      <table class="p-table ki">
        <caption>
          Metas propostas; resultado e desvio dependem de base validada. Definições pendentes:
          {pendingIds.map((id) => <VRef id={id} />)}
        </caption>
        <thead>
          <tr>
            <th scope="col">Indicador</th>
            <th scope="col">Meta proposta</th>
            <th scope="col">Resultado atual</th>
            <th scope="col">Desvio</th>
            <th scope="col">Definição</th>
          </tr>
        </thead>
        <tbody>
          {
            indicators.map((ind) => (
              <tr>
                <th scope="row">{ind.name}</th>
                <td data-label="Meta proposta" class:list={["ki__target", { "ki__target--long": ind.target.length > 8 }]}>
                  {brk(ind.target)}
                </td>
                <td data-label="Resultado atual" class:list={["ki__cur", { "ki__na": !ind.current }]}>
                  {ind.current ?? "Não disponível"}
                </td>
                <td data-label="Desvio" class:list={["ki__dev", { "ki__na": !ind.deviation }]}>
                  {ind.deviation ?? "Não calculável"}
                </td>
                <td data-label="Definição" class="ki__def">{ind.definition}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="ki__more">
      <div class="ki__june" data-reveal>
        <p class="ki__label">Marcos de junho de 2027</p>
        <ul>
          {
            juneMilestones.map((m) => (
              <li>
                <span class:list={["ki__jv", { "ki__jv--long": m.target.length > 8 }]}>{m.target}</span>
                <span class="ki__jl">
                  <strong>{m.name}</strong>
                  {m.definition}
                  <VRef id={m.v} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ki__routine" data-reveal style="--reveal-delay:100ms">
        <p class="ki__label">Rotina de gestão</p>
        <ul>
          {
            routine.map((r) => (
              <li>
                <span class="ki__cad">{r.cadence}</span>
                <strong>{r.when}</strong>
                <span>
                  {r.title}: {r.text}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ki__summary {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-bottom: 1.2rem;
  }
  .ki__sum {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--p-gray);
  }
  .ki__sum b {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--p-green-dark);
  }
  .ki__sum--empty b {
    color: var(--p-gray);
  }

  .ki {
    table-layout: fixed;
  }
  .ki thead th:nth-child(1) {
    width: 21%;
  }
  .ki thead th:nth-child(2) {
    width: 18%;
  }
  .ki thead th:nth-child(3),
  .ki thead th:nth-child(4) {
    width: 14%;
  }
  .ki__target {
    font-size: clamp(1.4rem, 1.15rem + 0.9vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--p-green-dark);
  }
  .ki__target--long {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .ki__cur,
  .ki__dev {
    font-weight: 600;
    color: var(--p-graphite);
  }
  .ki__na {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--p-gray);
    font-style: italic;
  }
  .ki__def {
    color: var(--p-gray);
  }
  .ki caption :global(.vref) {
    margin-left: 0.3rem;
  }

  .ki__more {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 960px) {
    .ki__more {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .ki__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-gray);
    margin-bottom: 0.7rem;
  }
  .ki__june ul,
  .ki__routine ul {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--p-green-dark);
  }
  .ki__june li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--p-line);
  }
  .ki__jv {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--p-green-dark);
  }
  .ki__jv--long {
    font-size: var(--step-0);
    line-height: 1.3;
  }
  .ki__jl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
    font-size: 0.84rem;
    color: var(--p-gray);
  }
  .ki__jl strong {
    color: var(--p-graphite);
    margin-right: 0.2rem;
  }
  .ki__routine li {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--p-line);
  }
  .ki__cad {
    padding: 0.15rem 0.55rem;
    border-radius: 100px;
    background: var(--p-green-dark);
    color: #fff;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ki__routine strong {
    font-size: var(--step-1);
    color: var(--p-green-dark);
    letter-spacing: -0.02em;
  }
  .ki__routine li span:last-child {
    font-size: 0.84rem;
    color: var(--p-gray);
  }
  /* Resultado e desvio lado a lado no mobile */
  @media screen and (max-width: 860px) {
    .ki .ki__cur,
    .ki .ki__dev {
      display: inline-block;
      width: 49%;
      vertical-align: top;
    }
  }
  @media (max-width: 520px) {
    .ki__june li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
  @media print {
    .ki__target {
      font-size: 12pt;
      overflow-wrap: normal !important;
      hyphens: manual;
    }
    .ki__target--long {
      font-size: 9pt;
    }
  }
</style>
