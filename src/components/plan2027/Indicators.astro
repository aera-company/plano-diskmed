---
import SectionHead from "./SectionHead.astro";
import {
  indicators,
  routine,
  INDICATOR_STATE_LABEL,
  type IndicatorState,
} from "../../data/plan2027";

const stateOrder: IndicatorState[] = ["definida", "pendente", "semBaseline"];
const counts = stateOrder.map((s) => ({
  state: s,
  label: INDICATOR_STATE_LABEL[s],
  n: indicators.filter((i) => i.states.includes(s)).length,
}));
---

<section id="indicadores" class="p-section p-section--soft">
  <div class="container container-wide">
    <SectionHead
      num="08"
      eyebrow="Painel de indicadores"
      title="Gestão semanal e mensal."
      lead="Indicadores propostos para acompanhar a meta. O atingimento atual não é exibido: as bases de comparação ainda serão consolidadas."
      split
    />

    <ul class="in__summary" data-reveal aria-label="Resumo dos estados dos indicadores">
      {
        counts.map((c) => (
          <li class={`in__sum in__sum--${c.state}`}>
            <span class="in__sum-n">{c.n}</span>
            <span class="in__sum-l">
              {c.label}
              <small>de {indicators.length} indicadores</small>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="p-table-wrap" data-reveal>
      <table class="p-table in__table">
        <caption>Indicadores propostos, meta e pendência de definição. Nenhum valor de atingimento foi preenchido.</caption>
        <thead>
          <tr>
            <th scope="col">Indicador</th>
            <th scope="col" class="in__num">Meta proposta</th>
            <th scope="col">Estado</th>
            <th scope="col">Definição / pendência</th>
          </tr>
        </thead>
        <tbody>
          {
            indicators.map((ind) => (
              <tr>
                <th scope="row">{ind.name}</th>
                <td class="in__num in__target" data-label="Meta proposta">
                  {/* quebra opcional após "/" para metas longas (ex.: representante/mês) */}
                  {ind.target.replace("/", "/​")}
                </td>
                <td data-label="Estado">
                  <span class="in__states">
                    {ind.states.map((s) => (
                      <span class={`st-chip st-chip--${s}`}>{INDICATOR_STATE_LABEL[s]}</span>
                    ))}
                  </span>
                </td>
                <td data-label="Definição / pendência" class="in__def">{ind.definition}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="in__routine">
      {
        routine.map((r, i) => (
          <article class="p-card in__r" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="in__r-cad">{r.cadence}</span>
            <p class="in__r-when">{r.when}</p>
            <h3>{r.title}</h3>
            <p class="in__r-text">{r.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .in__summary {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .in__sum {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.15rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--p-line);
  }
  .in__sum-n {
    font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green-dark);
  }
  .in__sum--pendente .in__sum-n {
    color: var(--p-amber-ink);
  }
  .in__sum--semBaseline .in__sum-n {
    color: var(--p-gray);
  }
  .in__sum-l {
    display: grid;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--p-graphite);
    line-height: 1.3;
  }
  .in__sum-l small {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--p-gray);
  }
  @media (max-width: 640px) {
    .in__summary {
      gap: 0.5rem;
    }
    .in__sum {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
      padding: 0.85rem;
    }
    .in__sum-l small {
      display: none;
    }
  }

  .in__table {
    table-layout: fixed;
  }
  .in__table th[scope="row"],
  .in__table thead th:nth-child(1) {
    width: 24%;
  }
  .in__table thead th:nth-child(2) {
    width: 17%;
  }
  .in__table thead th:nth-child(3) {
    width: 25%;
  }
  .in__num {
    text-align: left;
  }
  .in__target {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--p-green-dark);
  }
  .in__def {
    color: var(--p-gray);
  }
  .in__states {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .st-chip {
    display: inline-block;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .st-chip--definida {
    background: var(--p-soft);
    color: var(--p-green-mid);
  }
  .st-chip--pendente {
    background: var(--p-amber-bg);
    color: var(--p-amber-ink);
  }
  .st-chip--semBaseline {
    background: var(--p-offwhite);
    color: var(--p-gray);
    border: 1px solid var(--p-line-strong);
  }
  @media screen and (max-width: 860px) {
    .in__table th[scope="row"] {
      width: 100%;
    }
    .in__num {
      text-align: left;
    }
  }

  @media print {
    .in__target {
      font-size: 10.5pt;
      overflow-wrap: normal;
    }
  }

  .in__routine {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: clamp(0.9rem, 1.6vw, 1.25rem);
  }
  @media (min-width: 760px) {
    .in__routine {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .in__r-cad {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    background: var(--p-green-dark);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .in__r-when {
    margin-top: 1rem;
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--p-green-dark);
  }
  .in__r h3 {
    margin-top: 0.3rem;
    font-size: var(--step-0);
    color: var(--p-graphite);
  }
  .in__r-text {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--p-gray);
    line-height: 1.5;
  }
</style>
