---
import SectionHead from "./SectionHead.astro";
import Badge from "./Badge.astro";
import {
  coordinator,
  roles,
  externalRelations,
} from "../../data/plan2027";

const tiers = ["Validação", "Coordenação", "Execução"].map((t) => ({
  tier: t,
  nodes: roles.filter((r) => r.tier === t),
}));
---

<section id="estrutura" class="p-section">
  <div class="container container-wide">
    <SectionHead
      num="03"
      eyebrow="Estrutura comercial"
      title="Papéis e responsabilidades."
      lead="Quem valida, quem coordena e quem executa cada frente do plano. Representação funcional, sem definir vínculo hierárquico formal ainda não aprovado."
      split
    />

    <div class="st">
      <figure class="p-card st__map p-avoid-break" data-reveal aria-label="Diagrama funcional da estrutura comercial">
        {
          tiers.map((t, i) => (
            <div class="st__tier" data-tier={t.tier}>
              <span class="st__tier-label">{t.tier}</span>
              <div class:list={["st__nodes", `st__nodes--${t.nodes.length}`]}>
                {t.nodes.map((n) => (
                  <div class:list={["st__node", { "st__node--focus": n.tier === "Coordenação" }]}>
                    <strong>{n.name}</strong>
                    <span>{n.text}</span>
                  </div>
                ))}
              </div>
              {i < tiers.length - 1 && <span class="st__link" aria-hidden="true" />}
            </div>
          ))
        }
        <div class="st__ext">
          <span class="st__tier-label">Relacionamento externo</span>
          <ul>
            {externalRelations.map((e) => <li>{e}</li>)}
          </ul>
        </div>
        <figcaption class="st__note">
          Linhas tracejadas indicam relação funcional, não subordinação.
        </figcaption>
      </figure>

      <article class="p-card st__coord" data-reveal style="--reveal-delay:100ms">
        <p class="st__coord-role">{coordinator.role}</p>
        <h3 class="st__coord-name">{coordinator.name}</h3>
        <ul class="st__duties">
          {
            coordinator.duties.map((d) => (
              <li>
                <p>{d.text}</p>
                {d.status !== "acao" && <Badge status={d.status} />}
              </li>
            ))
          }
        </ul>

        <div class="st__ind">
          <div class="st__ind-head">
            <p>Indústrias em prospecção com a Diretoria</p>
            <Badge status="validar" label="Alvos · não são parceiros fechados" />
          </div>
          <ul>
            {coordinator.targetIndustries.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .st {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 1060px) {
    .st {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: start;
    }
  }

  .st__tier {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding-bottom: 2rem;
  }
  .st__tier-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-gray);
  }
  .st__nodes {
    display: grid;
    gap: 0.7rem;
  }
  @media (min-width: 720px) {
    .st__nodes--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .st__node {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--p-line);
    border-radius: 12px;
    background: #fff;
  }
  .st__node strong {
    color: var(--p-green-dark);
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }
  .st__node span {
    font-size: 0.84rem;
    color: var(--p-gray);
    line-height: 1.45;
  }
  .st__node--focus {
    background: var(--p-green-dark);
    border-color: var(--p-green-dark);
  }
  .st__node--focus strong {
    color: #fff;
  }
  .st__node--focus span {
    color: rgba(255, 255, 255, 0.74);
  }
  /* conector tracejado entre camadas */
  .st__link {
    position: absolute;
    left: 50%;
    bottom: 0.25rem;
    height: 1.5rem;
    border-left: 2px dashed var(--p-line-strong);
  }

  .st__ext {
    display: grid;
    gap: 0.7rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--p-line-strong);
  }
  .st__ext ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .st__ext li {
    padding: 0.5rem 0.9rem;
    border-radius: 100px;
    background: var(--p-soft);
    color: var(--p-green-mid);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .st__note {
    margin-top: 1.1rem;
    font-size: 0.78rem;
    color: var(--p-gray);
  }

  .st__coord-role {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-green-mid);
  }
  .st__coord-name {
    margin-top: 0.4rem;
    font-size: var(--step-2);
    color: var(--p-green-dark);
    letter-spacing: -0.025em;
  }
  .st__duties {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    display: grid;
  }
  .st__duties li {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding: 0.9rem 0 0.9rem 1.2rem;
    border-top: 1px solid var(--p-line);
    position: relative;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .st__duties li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--p-green);
  }
  .st__ind {
    margin-top: 0.6rem;
    padding: 1.1rem;
    border-radius: 12px;
    background: var(--p-offwhite);
    border: 1px solid var(--p-line);
  }
  .st__ind-head {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
  }
  .st__ind-head p {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--p-graphite);
  }
  .st__ind ul {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .st__ind li {
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    background: #fff;
    border: 1px dashed var(--p-line-strong);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--p-green-dark);
  }
</style>
