---
// Esboço do Radar Comercial (bloco Metas): um iPad desenhado em HTML/CSS com
// a estrutura das quatro telas. Sem números — é ilustrativo; os dados reais
// ficam na versão interna, fora do site.
import { radar } from "../../data/plan2027";

// Barras genéricas, decrescentes: só a forma de um ranking (não são dados).
const bars = [100, 84, 70, 59, 50, 42, 35, 29, 24, 20, 17, 14, 12, 10];
const buys = [true, false, true, true, false, true, false, true, false, false, true, false, false, true];
const rows = [0, 1, 2, 3, 4, 5, 6, 7, 8];
---

<div class="rs" data-motion>
  <div class="rs__copy">
    <p class="p-label">Acompanhamento</p>
    <h3 class="rs__name">{radar.name}</h3>
    <p class="rs__text">{radar.text}</p>
    <ol class="rs__screens">
      {
        radar.screens.map((s) => (
          <li>
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <figure class="rs__fig">
    <div class="rs__device" aria-hidden="true">
      <div class="rs__screen">
        <aside class="rs__side">
          <span class="rs__logo"><i></i><b>Radar</b></span>
          {radar.screens.map((s, i) => <span class:list={["rs__nav", { "rs__nav--on": i === 0 }]}>{s.title}</span>)}
        </aside>
        <div class="rs__main">
          <div class="rs__top">
            <span class="rs__title">{radar.name}</span>
            <span class="rs__chip"></span>
          </div>
          <div class="rs__tiles">
            {[0, 1, 2].map(() => <span class="rs__tile"><i class="rs__sk rs__sk--s"></i><i class="rs__sk rs__sk--l"></i></span>)}
          </div>
          <div class="rs__panels">
            <div class="rs__card">
              <i class="rs__sk rs__sk--m"></i>
              <div class="rs__bars">
                {
                  bars.map((w, i) => (
                    <span class="rs__bar" style={`--w:${w}%; --i:${i}`}>
                      <i class="rs__sk rs__sk--xs"></i>
                      <b class:list={{ "rs__bar--buy": buys[i] }}></b>
                    </span>
                  ))
                }
              </div>
            </div>
            <div class="rs__card">
              <i class="rs__sk rs__sk--m"></i>
              <div class="rs__rows">
                {
                  rows.map((r) => (
                    <span class="rs__row" style={`--i:${r}`}>
                      <i class="rs__sk"></i>
                      <i class="rs__pill"></i>
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <figcaption>{radar.note}</figcaption>
  </figure>
</div>

<style>
  .rs {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    margin: 0.4rem 0 1.2rem;
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    border-top: 1px solid var(--p-line);
  }
  @media (min-width: 960px) {
    .rs {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  .rs__name {
    margin-top: 0.3rem;
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    color: var(--p-green-dark);
  }
  .rs__text {
    margin-top: 0.4rem;
    max-width: 38ch;
    color: var(--p-gray);
  }
  .rs__screens {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .rs__screens li {
    display: grid;
    gap: 0.05rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--p-green);
  }
  .rs__screens strong {
    color: var(--p-green-dark);
  }
  .rs__screens span {
    font-size: 0.86rem;
    color: var(--p-gray);
  }

  /* ---------- iPad (proporção 4:3, conteúdo em unidades do contêiner) ---------- */
  .rs__fig {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .rs__fig figcaption {
    font-size: 0.78rem;
    color: var(--p-gray);
  }
  .rs__device {
    container-type: inline-size;
    width: 100%;
    max-width: 44rem;
    aspect-ratio: 4 / 3;
    padding: 2.4%;
    border-radius: 5.5% / 7.3%;
    background: #1b1f1c;
    box-shadow: 0 0 0 1px #2e3530 inset;
  }
  .rs__screen {
    display: grid;
    grid-template-columns: 20% 1fr;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 3% / 4%;
    background: #f5f7f4;
  }
  .rs__side {
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 3cqw 2cqw;
    background: var(--p-green-dark);
  }
  .rs__logo {
    display: flex;
    align-items: center;
    gap: 1cqw;
    margin-bottom: 1.5cqw;
    color: #fff;
    font-size: 2.2cqw;
  }
  .rs__logo i {
    width: 3cqw;
    height: 3cqw;
    border-radius: 50%;
    border: 0.45cqw solid var(--p-green);
  }
  .rs__nav {
    padding: 0.9cqw 1.2cqw;
    border-radius: 1cqw;
    font-size: 1.7cqw;
    color: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
  }
  .rs__nav--on {
    background: rgba(141, 198, 63, 0.22);
    color: #fff;
  }
  .rs__main {
    display: flex;
    flex-direction: column;
    gap: 2cqw;
    min-width: 0;
    padding: 3cqw;
  }
  .rs__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rs__title {
    font-size: 2.6cqw;
    font-weight: 600;
    color: var(--p-green-dark);
  }
  .rs__chip {
    width: 12cqw;
    height: 2.4cqw;
    border-radius: 2cqw;
    background: #e4ebe0;
  }
  .rs__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6cqw;
  }
  .rs__tile,
  .rs__card {
    display: grid;
    gap: 1.2cqw;
    align-content: start;
    padding: 1.8cqw;
    border-radius: 1.4cqw;
    background: #fff;
    border: 1px solid #e2e9dd;
  }
  .rs__panels {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.6cqw;
    flex: 1;
    min-height: 0;
  }
  /* Esqueleto: barras cinza no lugar de texto e números */
  .rs__sk {
    display: block;
    width: 70%;
    height: 1.3cqw;
    border-radius: 1cqw;
    background: #e4ebe0;
  }
  .rs__sk--xs {
    width: 9cqw;
    height: 1cqw;
  }
  .rs__sk--s {
    width: 55%;
    height: 1cqw;
  }
  .rs__sk--m {
    width: 50%;
  }
  .rs__sk--l {
    width: 40%;
    height: 3cqw;
    background: #cfdcc6;
  }
  .rs__bars,
  .rs__rows {
    display: grid;
    gap: 1cqw;
  }
  .rs__bar {
    display: grid;
    grid-template-columns: 10cqw 1fr;
    align-items: center;
    gap: 1cqw;
  }
  .rs__bar b {
    display: block;
    width: var(--w);
    height: 1.4cqw;
    border-radius: 1cqw;
    background: #cfd9c8;
    transform-origin: left;
  }
  .rs__bar b.rs__bar--buy {
    background: var(--p-green);
  }
  .rs__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1cqw;
    padding-bottom: 1cqw;
    border-bottom: 1px solid #eef2eb;
  }
  .rs__pill {
    width: 7cqw;
    height: 1.8cqw;
    border-radius: 2cqw;
    border: 1px solid #cfd9c8;
  }

  /* ---------- Movimento: o aparelho entra e o gráfico se desenha ---------- */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .rs__copy,
    :global(.m-on) .rs__fig {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
      transition: opacity var(--m-in) var(--m-ease), transform var(--m-in) var(--m-ease);
    }
    :global(.m-on) .rs__fig {
      transition-delay: 120ms;
    }
    :global(.m-on) .rs__bar b {
      transform: scaleX(0);
      transition: transform 700ms var(--m-ease) calc(500ms + var(--i) * 60ms);
    }
    :global(.m-on) .rs.is-visible .rs__copy,
    :global(.m-on) .rs.is-visible .rs__fig,
    :global(.m-on) .rs.is-visible .rs__bar b {
      opacity: 1;
      transform: none;
    }
  }
  @media print {
    .rs {
      grid-template-columns: 1fr 1fr;
      gap: 6mm;
      margin: 0;
      padding: 4mm 0 0;
      break-inside: avoid;
    }
    .rs__name {
      font-size: 14pt;
    }
    .rs__text,
    .rs__screens span {
      font-size: 8pt;
    }
    .rs__screens {
      gap: 1.5mm;
      margin-top: 2mm;
    }
    .rs__device {
      max-width: 82mm;
    }
  }
</style>
