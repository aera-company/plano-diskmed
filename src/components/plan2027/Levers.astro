---
// Bloco 03 · Estratégia (V04) — cinco alavancas, cada uma com título e uma
// frase, convergindo para a meta central de +15%.
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import { levers, leversLead, opening } from "../../data/plan2027";

const n = levers.length;
// Linhas de convergência: do centro de cada coluna até o centro da meta.
const VW = 1000,
  VH = 120;
const paths = levers.map((_, i) => {
  const x0 = ((i + 0.5) / n) * VW;
  return `M${x0} 0 C${x0} ${VH * 0.55}, ${VW / 2} ${VH * 0.45}, ${VW / 2} ${VH}`;
});
---

<section id="estrategia" class="p-section">
  <div class="container container-wide">
    <SectionHead num="03" eyebrow="Estratégia" title="Cinco frentes. Uma meta." lead={leversLead} split />

    <div class="lv" data-levers>
      <ol class="lv__fronts">
        {
          levers.map((l, i) => (
            <li class="lv__front" data-front={i}>
              <span class="lv__num">{l.num}</span>
              <h3 class="lv__title">{l.title}</h3>
              <p class="lv__text">{l.summary}</p>
            </li>
          ))
        }
      </ol>

      <svg class="lv__lines" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" aria-hidden="true">
        {paths.map((d, i) => <path d={d} data-line={i} />)}
      </svg>

      <p class="lv__goal">
        <span class="lv__goal-num">{opening.kpi.display}</span>
        <span class="lv__goal-label">
          {opening.kpi.label}
          <VRef id={opening.kpi.v} />
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .lv__fronts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 900px) {
    .lv__fronts {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .lv__front {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    column-gap: 0.6rem;
    align-content: start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--p-line);
    transition: opacity 0.2s var(--ease);
  }
  @media (min-width: 900px) {
    .lv__front {
      grid-template-columns: 1fr;
      row-gap: 0.4rem;
      padding: 1.1rem 1.2rem 1.2rem;
      border-top: 2px solid var(--p-green-dark);
    }
    .lv__front:first-child {
      padding-left: 0;
    }
    .lv__front + .lv__front {
      border-left: 1px solid var(--p-line);
    }
  }
  .lv__num {
    grid-row: span 2;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green-text);
  }
  @media (min-width: 900px) {
    .lv__num {
      grid-row: auto;
    }
  }
  .lv__title {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--p-green-dark);
  }
  .lv__text {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--p-graphite);
  }

  /* Linhas de convergência (desktop) */
  .lv__lines {
    display: none;
  }
  @media (min-width: 900px) {
    .lv__lines {
      display: block;
      width: 100%;
      height: 56px;
      overflow: visible;
    }
  }
  .lv__lines path {
    fill: none;
    stroke: var(--p-green);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.2s var(--ease), stroke-width 0.2s var(--ease);
  }
  .lv[data-active] .lv__front {
    opacity: 0.45;
  }
  .lv[data-active] .lv__front[data-on] {
    opacity: 1;
  }
  .lv[data-active] .lv__lines path {
    stroke: var(--p-line-strong);
  }
  .lv[data-active] .lv__lines path[data-on] {
    stroke: var(--p-green-dark);
    stroke-width: 2.5;
  }

  .lv__goal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.1rem;
  }
  @media (min-width: 900px) {
    .lv__goal {
      justify-content: center;
      margin-top: 0.3rem;
    }
  }
  .lv__goal-num {
    padding: 0.1rem 1.1rem;
    border-radius: 100px;
    background: var(--p-green-dark);
    color: #fff;
    font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }
  .lv__goal-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--p-graphite);
  }
  @media print {
    .lv__fronts {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .lv__front {
      grid-template-columns: 1fr;
      padding: 3mm 2.5mm;
      border-top: 2px solid var(--p-green-dark);
    }
    .lv__front + .lv__front {
      border-left: 1px solid var(--p-line);
    }
    .lv__num {
      grid-row: auto;
    }
    .lv__title {
      font-size: 10pt;
      hyphens: auto;
    }
    .lv__text {
      font-size: 8pt;
    }
    .lv__goal {
      justify-content: center;
    }
  }
</style>
