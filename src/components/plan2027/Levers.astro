---
import SectionHead from "./SectionHead.astro";
import VRef from "./VRef.astro";
import { levers, leversLead, leversNote, opening, diagnostics } from "../../data/plan2027";

const problemOf = Object.fromEntries(diagnostics.map((d) => [d.id, d.problem]));
const n = levers.length;
// Linhas de convergência: do centro de cada coluna até o centro da meta.
const VW = 1000,
  VH = 120;
const paths = levers.map((_, i) => {
  const x0 = ((i + 0.5) / n) * VW;
  return `M${x0} 0 C${x0} ${VH * 0.55}, ${VW / 2} ${VH * 0.45}, ${VW / 2} ${VH}`;
});
---

<section id="frentes" class="p-section lv-sec">
  <div class="container container-wide">
    <SectionHead
      num="03"
      eyebrow="As alavancas do crescimento"
      title="Cinco frentes. Uma meta."
      lead={leversLead}
      split
    />

    <div class="lv" data-reveal data-levers>
      <ol class="lv__fronts">
        {
          levers.map((l, i) => (
            <li class="lv__front" data-front={i} style={`--i:${i}`}>
              <span class="lv__num">{l.num}</span>
              <h3 class="lv__title">{l.title}</h3>
              <ul class="lv__items">
                {l.items.map((it) => <li>{it}</li>)}
              </ul>
              {l.answers.length > 0 && (
                <p class="lv__answers">
                  Responde a
                  {l.answers.map((id) => (
                    <a href={`#${id.toLowerCase()}`} title={problemOf[id]}>{id}</a>
                  ))}
                </p>
              )}
            </li>
          ))
        }
      </ol>

      <svg class="lv__lines" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" aria-hidden="true">
        {
          paths.map((d, i) => (
            <path d={d} pathLength="1" data-line={i} style={`--i:${i}`} />
          ))
        }
      </svg>

      <div class="lv__goal">
        <span class="lv__goal-num">{opening.kpi.display}</span>
        <span class="lv__goal-label">
          {opening.kpi.label}
          <VRef id={opening.kpi.v} label="Base a validar" />
        </span>
      </div>
    </div>

    <p class="lv__note" data-reveal>{leversNote}</p>
  </div>
</section>

<style>
  .lv {
    position: relative;
  }
  .lv__fronts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 1000px) {
    .lv__fronts {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .lv__front {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 0 1.6rem 2.2rem;
    transition: opacity 0.3s var(--ease);
  }
  @media (min-width: 1000px) {
    .lv__front {
      padding: 1.4rem 1.4rem 1.8rem;
      border-top: 2px solid var(--p-line);
      transition: border-color 0.3s var(--ease), opacity 0.3s var(--ease);
    }
    .lv__front + .lv__front {
      border-left: 1px solid var(--p-line);
    }
  }
  /* Trilho vertical (mobile/tablet) que leva à meta */
  @media (max-width: 999px) {
    .lv__front::before {
      content: "";
      position: absolute;
      left: 0.45rem;
      top: 1.75rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--p-green);
      box-shadow: 0 0 0 4px var(--p-soft);
    }
    .lv__front::after {
      content: "";
      position: absolute;
      left: calc(0.45rem + 4px);
      top: 2.5rem;
      bottom: -1.75rem;
      width: 1px;
      background: var(--p-line-strong);
    }
  }
  .lv__num {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green-text);
    font-variant-numeric: tabular-nums;
  }
  .lv__title {
    font-size: var(--step-1);
    color: var(--p-green-dark);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .lv__items {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    margin-bottom: auto;
  }
  .lv__items li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--p-graphite);
  }
  .lv__items li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: 1px;
    background: var(--p-green-mid);
  }
  .lv__answers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--p-gray);
  }
  .lv__answers a {
    padding: 0.1rem 0.4rem;
    border-radius: 5px;
    background: var(--p-offwhite);
    border: 1px solid var(--p-line);
    color: var(--p-green-mid);
    font-weight: 700;
    transition: border-color 0.2s var(--ease);
  }
  .lv__answers a:hover,
  .lv__answers a:focus-visible {
    border-color: var(--p-green-mid);
  }

  /* Linhas de convergência (desktop) */
  .lv__lines {
    display: none;
  }
  @media (min-width: 1000px) {
    .lv__lines {
      display: block;
      width: 100%;
      height: 120px;
      overflow: visible;
    }
  }
  .lv__lines path {
    fill: none;
    stroke: var(--p-line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s var(--ease) calc(0.2s + var(--i) * 0.12s),
      stroke 0.3s var(--ease), stroke-width 0.3s var(--ease);
  }
  .lv.is-visible .lv__lines path {
    stroke-dashoffset: 0;
    stroke: var(--p-green);
  }

  /* Foco em uma frente: as demais recuam */
  .lv[data-active] .lv__front {
    opacity: 0.45;
  }
  .lv[data-active] .lv__front[data-on] {
    opacity: 1;
    border-top-color: var(--p-green-dark);
  }
  .lv[data-active] .lv__lines path {
    stroke: var(--p-line-strong);
  }
  .lv[data-active] .lv__lines path[data-on] {
    stroke: var(--p-green-dark);
    stroke-width: 2.5;
  }

  .lv__goal {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 1.4rem 0 0 2.2rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s var(--ease) 0.9s, transform 0.6s var(--ease) 0.9s;
  }
  @media (min-width: 1000px) {
    .lv__goal {
      justify-items: center;
      text-align: center;
      margin-top: 0;
      padding: 0.6rem 0 0;
    }
  }
  .lv.is-visible .lv__goal {
    opacity: 1;
    transform: none;
  }
  .lv__goal-num {
    display: inline-block;
    padding: 0.2rem 1.4rem;
    border-radius: 100px;
    background: var(--p-green-dark);
    color: #fff;
    font-size: clamp(2.6rem, 2rem + 2.4vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }
  .lv__goal-label {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--p-graphite);
  }
  .lv__note {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 78ch;
    font-size: 0.82rem;
    color: var(--p-gray);
  }
  @media (min-width: 1000px) {
    .lv__note {
      margin-inline: auto;
      text-align: center;
    }
  }

  @media print {
    .lv__lines path {
      stroke-dashoffset: 0;
      stroke: var(--p-green);
    }
    .lv__goal {
      opacity: 1;
      transform: none;
    }
  }
</style>
