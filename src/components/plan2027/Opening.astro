---
// Bloco 01 · Ambição 2027 — meta, tese central e o mapa do plano em números.
import VRef from "./VRef.astro";
import { opening, docMeta, quarters, diagnostics, levers, validations } from "../../data/plan2027";

const index = [
  { n: diagnostics.length, label: "problemas", href: "#diagnostico" },
  { n: levers.length, label: "frentes", href: "#estrategia" },
  { n: quarters.length, label: "trimestres", href: "#roadmap" },
  { n: validations.filter((v) => v.priority).length, label: "decisões prioritárias", href: "#decisoes" },
];
---

<section id="ambicao" class="hero" data-dark>
  <div class="container container-wide">
    <div class="hero__top" data-reveal>
      <p class="hero__eyebrow">{opening.eyebrow}</p>
      <p class="hero__sign">
        <strong>{docMeta.author}</strong>
        <span>{docMeta.authorRole} · {docMeta.version}</span>
      </p>
    </div>

    <div class="hero__stage">
      <div class="hero__copy">
        <h1 class="hero__title" data-reveal style="--reveal-delay:60ms">{opening.headline}</h1>
        <p class="hero__sub" data-reveal style="--reveal-delay:120ms">{opening.sub}</p>
      </div>

      <div class="hero__kpi" data-reveal style="--reveal-delay:100ms">
        <p class="hero__num">
          +{opening.kpi.value}<span class="hero__pct">%</span>
        </p>
        <p class="hero__kpi-meta">
          <span>{opening.kpi.label}</span>
          <VRef id={opening.kpi.v} label="Base 2026 a validar" dark />
        </p>
      </div>
    </div>

    <nav class="hero__index" aria-label="O plano em números" data-reveal>
      {
        index.map((i) => (
          <a href={i.href}>
            <b>{i.n}</b>
            <span>{i.label}</span>
          </a>
        ))
      }
    </nav>
    <p class="hero__key"><span aria-hidden="true"></span>Ponto âmbar: premissa a validar com a Diretoria.</p>
  </div>
</section>

<style>
  .hero {
    background: var(--p-green-dark);
    color: rgba(255, 255, 255, 0.86);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 3.5vw, 3rem);
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem 2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-green);
  }
  .hero__sign {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: var(--step--1);
  }
  .hero__sign strong {
    color: #fff;
    font-weight: 600;
  }
  .hero__sign span {
    color: rgba(255, 255, 255, 0.66);
  }

  .hero__stage {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin-top: clamp(2.25rem, 5vw, 4rem);
  }
  @media (min-width: 1040px) {
    .hero__stage {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 4rem;
    }
  }
  .hero__title {
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #fff;
    max-width: 16ch;
  }
  .hero__sub {
    margin-top: clamp(1.1rem, 2vw, 1.6rem);
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.74);
  }
  .hero__num {
    font-size: clamp(7rem, 2rem + 15vw, 15.5rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
    color: #fff;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-left: -0.04em;
  }
  .hero__pct {
    color: var(--p-green);
  }
  .hero__kpi-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-top: clamp(0.9rem, 2vw, 1.3rem);
    font-size: var(--step-0);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.86);
  }

  /* O plano em números: substitui o sumário */
  .hero__index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  @media (min-width: 760px) {
    .hero__index {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .hero__index a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 1rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s var(--ease);
  }
  .hero__index b {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green);
  }
  .hero__index span {
    font-size: var(--step--1);
    line-height: 1.25;
  }
  .hero__index a:hover,
  .hero__index a:focus-visible {
    color: #fff;
  }

  .hero__key {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .hero__key span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--p-amber);
  }
  @media print {
    .hero__num {
      font-size: 8rem;
    }
  }
</style>
