---
// Bloco 01 · Ambição 2027 — meta, tese central e o mapa do plano em números.
import VRef from "./VRef.astro";
import { opening, docMeta, quarters, diagnostics, levers, validations } from "../../data/plan2027";

// Traço mínimo de crescimento: degraus dos marcos acumulados propostos
// (0 → +3 → +7 → +11 → +15). Conceito da meta, não resultado.
const steps = [0, ...quarters.map((q) => q.milestone)];
const GW = 240,
  GH = 34;
const gx = (i: number) => (i / (steps.length - 1)) * GW;
const gy = (v: number) => GH - 2 - (v / steps[steps.length - 1]) * (GH - 4);
const growth = steps
  .map((v, i) => (i === 0 ? `M0 ${gy(v)}` : `H${gx(i).toFixed(1)} V${gy(v).toFixed(1)}`))
  .join(" ");

// Ordem de entrada do hero (ms): marca → título → meta → traço → frase → índice
const T = { top: 0, line: 120, num: 320, sub: 640, index: 760 };

const index = [
  { n: diagnostics.length, label: "problemas", href: "#diagnostico" },
  { n: levers.length, label: "frentes", href: "#estrategia" },
  { n: quarters.length, label: "trimestres", href: "#roadmap" },
  { n: validations.filter((v) => v.priority).length, label: "decisões prioritárias", href: "#decisoes" },
];
---

<section id="ambicao" class="hero" data-dark>
  <div class="container container-wide">
    <div class="hero__top" data-reveal style={`--reveal-delay:${T.top}ms`}>
      <p class="hero__eyebrow">{opening.eyebrow}</p>
      <p class="hero__sign">
        <strong>{docMeta.author}</strong>
        <span>{docMeta.authorRole} · {docMeta.version}</span>
      </p>
    </div>

    <div class="hero__stage">
      <div class="hero__copy">
        <h1 class="hero__title">
          {
            opening.headlineLines.map((line, i) => (
              <span class="hero__line" data-reveal style={`--reveal-delay:${T.line + i * 90}ms`}>
                {line}
              </span>
            ))
          }
        </h1>
        <p class="hero__sub" data-reveal style={`--reveal-delay:${T.sub}ms`}>{opening.sub}</p>
      </div>

      <div class="hero__kpi" data-reveal style={`--reveal-delay:${T.num}ms`}>
        <p class="hero__num">
          <span class="sr-only">{opening.kpi.display}</span>
          <span aria-hidden="true"
            ><span data-count={opening.kpi.value} data-pre="+" data-dur="900" data-delay={T.num}>+{opening.kpi.value}</span><span
              class="hero__pct">%</span
            ></span
          >
        </p>
        <svg class="hero__growth" viewBox={`-2 -2 ${GW + 4} ${GH + 4}`} aria-hidden="true">
          <path d={growth} pathLength="1" />
        </svg>
        <p class="hero__kpi-meta">
          <span>{opening.kpi.label}</span>
          <VRef id={opening.kpi.v} label="Base 2026 proposta" dark />
        </p>
      </div>
    </div>

    <nav class="hero__index" aria-label="O plano em números" data-reveal style={`--reveal-delay:${T.index}ms`}>
      {
        index.map((i) => (
          <a href={i.href}>
            <b>{i.n}</b>
            <span>{i.label}</span>
          </a>
        ))
      }
    </nav>
    <p class="hero__key" data-reveal style={`--reveal-delay:${T.index + 90}ms`}><span aria-hidden="true"></span>Ponto âmbar: proposta aguardando validação da Diretoria.</p>
  </div>
</section>

<style>
  .hero {
    background: var(--p-green-dark);
    color: rgba(255, 255, 255, 0.86);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 3.5vw, 3rem);
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem 2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-green);
  }
  .hero__sign {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: var(--step--1);
  }
  .hero__sign strong {
    color: #fff;
    font-weight: 600;
  }
  .hero__sign span {
    color: rgba(255, 255, 255, 0.66);
  }

  .hero__stage {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin-top: clamp(2.25rem, 5vw, 4rem);
  }
  @media (min-width: 1040px) {
    .hero__stage {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 4rem;
    }
  }
  .hero__title {
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #fff;
    max-width: 16ch;
  }
  .hero__sub {
    margin-top: clamp(1.1rem, 2vw, 1.6rem);
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.74);
  }
  .hero__num {
    font-size: clamp(7rem, 2rem + 15vw, 15.5rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
    color: #fff;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-left: -0.04em;
  }
  .hero__pct {
    color: var(--p-green);
  }
  .hero__line {
    display: block;
  }
  /* Degraus da meta: desenhados uma vez, depois que o número entra */
  .hero__growth {
    display: block;
    width: min(100%, 15rem);
    height: auto;
    margin-top: 1rem;
    overflow: visible;
  }
  .hero__growth path {
    fill: none;
    stroke: var(--p-green);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.m-on) .hero__growth path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset var(--m-info) var(--m-ease) 450ms;
    }
    :global(.m-on) .is-visible .hero__growth path {
      stroke-dashoffset: 0;
    }
  }
  .hero__kpi-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-top: clamp(0.9rem, 2vw, 1.3rem);
    font-size: var(--step-0);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.86);
  }

  /* O plano em números: substitui o sumário */
  .hero__index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  @media (min-width: 760px) {
    .hero__index {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .hero__index a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 1rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s var(--ease);
  }
  .hero__index b {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--p-green);
  }
  .hero__index span {
    font-size: var(--step--1);
    line-height: 1.25;
  }
  .hero__index a:hover,
  .hero__index a:focus-visible {
    color: #fff;
  }

  .hero__key {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .hero__key span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--p-amber);
  }
  @media print {
    .hero__num {
      font-size: 8rem;
    }
  }
</style>
