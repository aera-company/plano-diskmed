---
import VRef from "./VRef.astro";
import {
  opening,
  docMeta,
  quarters,
  diagnostics,
  levers,
  indicators,
} from "../../data/plan2027";

// Trajetória ilustrativa: início (0%) + marcos acumulados propostos.
const pts = [{ q: "Início", value: 0 }, ...quarters.map((q) => ({ q: q.q, value: q.milestone }))];
const W = 520,
  H = 250,
  padL = 16,
  padR = 30,
  top = 34,
  base = 206;
const max = quarters[quarters.length - 1].milestone;
const x = (i: number) => padL + (i / (pts.length - 1)) * (W - padL - padR);
const y = (v: number) => base - (v / max) * (base - top);
const line = pts.map((p, i) => `${i ? "L" : "M"}${x(i).toFixed(1)} ${y(p.value).toFixed(1)}`).join(" ");
const area = `${line} L${x(pts.length - 1).toFixed(1)} ${base} L${x(0).toFixed(1)} ${base} Z`;
const last = pts.length - 1;

// As três mensagens que a V02 precisa transmitir de imediato.
const proof = [
  {
    num: "01",
    title: "Diagnóstico concreto",
    text: `${diagnostics.length} restrições mapeadas, com ação, responsável e prazo.`,
    href: "#diagnostico",
  },
  {
    num: "02",
    title: "Plano executável",
    text: `${levers.length} frentes, ${quarters.length} trimestres e ${indicators.length} indicadores de acompanhamento.`,
    href: "#frentes",
  },
  {
    num: "03",
    title: "Liderança da execução",
    text: "Coordenação Comercial à frente, com a Diretoria nas decisões.",
    href: "#lideranca",
  },
];
---

<section id="abertura" class="hero" data-dark>
  <div class="container container-wide">
    <div class="hero__top" data-reveal>
      <p class="hero__eyebrow">{opening.eyebrow}</p>
      <p class="hero__sign">
        <strong>{docMeta.author}</strong>
        <span>{docMeta.authorRole} · {docMeta.version}</span>
      </p>
    </div>

    <h1 class="hero__title" data-reveal style="--reveal-delay:80ms">{opening.headline}</h1>

    <div class="hero__stage">
      <div class="hero__kpi" data-reveal style="--reveal-delay:140ms">
        <p class="hero__num">
          <span class="sr-only">{opening.kpi.display}</span>
          <span data-count={opening.kpi.value} data-pre="+" aria-hidden="true">+{opening.kpi.value}</span><span class="hero__pct" aria-hidden="true">%</span>
        </p>
        <div class="hero__kpi-meta">
          <span class="hero__kpi-label">{opening.kpi.label}</span>
          <VRef id={opening.kpi.v} label={opening.kpi.note} dark />
        </div>
      </div>

      <figure class="hero__chart" data-reveal style="--reveal-delay:220ms">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label="Trajetória ilustrativa dos marcos acumulados propostos: Q1 +3%, Q2 +7%, Q3 +11%, Q4 +15%"
        >
          <line class="hero__base" x1={padL} x2={W - padR} y1={base} y2={base} />
          <path class="hero__area" d={area}></path>
          <path class="hero__line" d={line} pathLength="1"></path>
          {
            pts.map((p, i) => (
              <g class="hero__pt" style={`--d:${0.6 + i * 0.12}s`}>
                {i === last && <circle class="hero__ring" cx={x(i)} cy={y(p.value)} r="7" />}
                <circle class="hero__dot" cx={x(i)} cy={y(p.value)} r={i === last ? 6 : 4} />
                {i > 0 && (
                  <text class="hero__pv" x={x(i)} y={y(p.value) - 15}>
                    +{p.value}%
                  </text>
                )}
                <text class="hero__pq" x={x(i)} y={base + 26}>
                  {p.q}
                </text>
              </g>
            ))
          }
        </svg>
        <figcaption>Marcos acumulados propostos · ilustrativo, não é faturamento realizado.</figcaption>
      </figure>
    </div>

    <div class="hero__foot">
      <p class="hero__sub" data-reveal>{opening.sub}</p>
      <ol class="hero__proof" data-reveal style="--reveal-delay:120ms">
        {
          proof.map((p) => (
            <li>
              <a href={p.href}>
                <span class="hero__proof-num">{p.num}</span>
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="hero__key" data-reveal>
      Como ler: valores são metas propostas para 2027; hipóteses indicam efeito esperado;
      os códigos <b>V1–V10</b> apontam decisões pendentes da Diretoria, reunidas no painel final.
    </p>
  </div>
</section>

<style>
  .hero {
    background: var(--p-green-dark);
    color: rgba(255, 255, 255, 0.86);
    padding-top: clamp(2.75rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-green);
  }
  .hero__sign {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: var(--step--1);
  }
  .hero__sign strong {
    color: #fff;
    font-weight: 600;
  }
  .hero__sign span {
    color: rgba(255, 255, 255, 0.66);
  }

  .hero__title {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #fff;
    max-width: 22ch;
  }

  .hero__stage {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: end;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 1040px) {
    .hero__stage {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
  .hero__num {
    font-size: clamp(7.5rem, 3rem + 16vw, 19rem);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.065em;
    color: #fff;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-left: -0.04em;
  }
  .hero__pct {
    color: var(--p-green);
  }
  .hero__kpi-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
  .hero__kpi-label {
    font-size: var(--step-0);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.86);
  }

  .hero__chart {
    min-width: 0;
    padding-bottom: 0.2rem;
  }
  .hero__chart svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero__chart figcaption {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.66);
  }
  .hero__base {
    stroke: rgba(255, 255, 255, 0.18);
  }
  .hero__area {
    fill: rgba(141, 198, 63, 0.12);
    opacity: 0;
    transition: opacity 1s var(--ease) 0.7s;
  }
  .hero__line {
    fill: none;
    stroke: var(--p-green);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s var(--ease) 0.3s;
  }
  .hero__dot {
    fill: var(--p-green-dark);
    stroke: var(--p-green);
    stroke-width: 2.5;
    opacity: 0;
    transition: opacity 0.4s var(--ease) var(--d);
  }
  .hero__ring {
    fill: none;
    stroke: var(--p-green);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .hero__pv {
    fill: #fff;
    font-size: 15px;
    font-weight: 700;
    text-anchor: middle;
    opacity: 0;
    transition: opacity 0.4s var(--ease) var(--d);
  }
  .hero__pq {
    fill: rgba(255, 255, 255, 0.68);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-anchor: middle;
  }
  .is-visible .hero__line {
    stroke-dashoffset: 0;
  }
  .is-visible .hero__area,
  .is-visible .hero__dot,
  .is-visible .hero__pv {
    opacity: 1;
  }
  /* Microanimação: o marco final pulsa duas vezes ao chegar */
  .is-visible .hero__ring {
    animation: heroRing 2.2s var(--ease) 2s 2;
  }
  @keyframes heroRing {
    0% {
      opacity: 0.7;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(3.2);
    }
  }
  @media (max-width: 560px) {
    .hero__pv {
      font-size: 22px;
    }
    .hero__pq {
      font-size: 18px;
    }
  }

  .hero__foot {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  @media (min-width: 1040px) {
    .hero__foot {
      grid-template-columns: 0.8fr 1.6fr;
      align-items: start;
    }
  }
  .hero__sub {
    font-size: var(--step-0);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    max-width: 40ch;
  }
  .hero__proof {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 720px) {
    .hero__proof {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }
  .hero__proof a {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.3s var(--ease);
  }
  @media (min-width: 720px) {
    .hero__proof a {
      padding: 0;
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.14);
      padding-left: 1.1rem;
    }
    .hero__proof a:hover {
      border-left-color: var(--p-green);
    }
  }
  .hero__proof-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--p-green);
  }
  .hero__proof strong {
    color: #fff;
    font-size: var(--step-0);
    font-weight: 600;
  }
  .hero__proof span:last-child {
    font-size: 0.86rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.68);
  }
  .hero__key {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.66);
    max-width: 90ch;
  }
  .hero__key b {
    color: #f4cf8f;
    font-weight: 600;
  }

  @media print {
    .hero__line {
      stroke-dashoffset: 0;
    }
    .hero__area,
    .hero__dot,
    .hero__pv {
      opacity: 1;
    }
    .hero__num {
      font-size: 9rem;
    }
    .hero__foot,
    .hero__proof {
      break-inside: avoid;
    }
  }
</style>
