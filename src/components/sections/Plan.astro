---
const points = [
  { m: "Mês 0", v: 1700, note: "1.700 clientes positivados" },
  { m: "Mês 3", v: 2000, note: "Mapeamento e abertura dos grupos prioritários" },
  { m: "Mês 6", v: 2300, note: "Novos acordos comerciais implementados" },
  { m: "Mês 9", v: 2600, note: "Expansão em associações e redes estratégicas" },
  { m: "Mês 12", v: 3000, note: "3.000 clientes positivados" },
];

// Geometria do gráfico
const W = 600,
  H = 260,
  padL = 46,
  padR = 30,
  padT = 24,
  padB = 46;
const min = 1700,
  max = 3000;
const xs = points.map(
  (_, i) => padL + (i / (points.length - 1)) * (W - padL - padR)
);
const ys = points.map(
  (p) => H - padB - ((p.v - min) / (max - min)) * (H - padT - padB)
);
const linePath = xs.map((x, i) => `${i ? "L" : "M"}${x.toFixed(1)} ${ys[i].toFixed(1)}`).join(" ");
const areaPath = `${linePath} L${xs[xs.length - 1].toFixed(1)} ${H - padB} L${xs[0].toFixed(1)} ${H - padB} Z`;

const kpis = [
  { pre: "+", v: 75, suf: "%", label: "Potencial de expansão" },
  { pre: "+", v: 1300, group: true, label: "Novos clientes" },
  { pre: "R$ ", v: 31.2, suf: " Mi", dec: 1, label: "Potencial anual" },
];
---

<section id="plano" class="section bg-soft plan">
  <div class="container container-wide">
    <header class="plan__head">
      <p class="eyebrow eyebrow--line" data-num="09" data-reveal>
        O que muda em 12 meses
      </p>
      <h2 class="section-title" data-reveal>
        Crescimento planejado. Resultado sustentável.
      </h2>
    </header>

    <figure class="plan__chart card" data-reveal>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Curva de crescimento de 1.700 para 3.000 clientes positivados em 12 meses">
        <defs>
          <linearGradient id="planArea" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--green)" stop-opacity="0.28" />
            <stop offset="1" stop-color="var(--green)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <!-- grelha -->
        {
          [0, 0.25, 0.5, 0.75, 1].map((t) => {
            const y = H - padB - t * (H - padT - padB);
            return <line class="plan__grid" x1={padL} y1={y} x2={W - padR} y2={y} />;
          })
        }
        <path class="plan__area" d={areaPath} fill="url(#planArea)"></path>
        <path class="plan__line" d={linePath} fill="none"></path>
        {
          points.map((p, i) => (
            <g class="plan__pt" style={`--d:${0.9 + i * 0.12}s`}>
              <circle cx={xs[i]} cy={ys[i]} r="4.5" />
              <text class="plan__pv" x={xs[i]} y={ys[i] - 12}>
                {p.v.toLocaleString("pt-BR")}
              </text>
              <text class="plan__pm" x={xs[i]} y={H - padB + 22}>
                {p.m}
              </text>
            </g>
          ))
        }
      </svg>
    </figure>

    <ol class="plan__timeline" data-reveal>
      {
        points.map((p, i) => (
          <li class="plan__step" style={`--reveal-delay:${i * 80}ms`}>
            <span class="plan__dot" />
            <span class="plan__m">{p.m}</span>
            <span class="plan__note">{p.note}</span>
          </li>
        ))
      }
    </ol>

    <dl class="plan__kpis" data-reveal>
      {
        kpis.map((k) => (
          <div class="plan__kpi">
            <dt
              class="stat-num"
              data-count={k.v}
              data-pre={k.pre ?? ""}
              data-suf={k.suf ?? ""}
              data-dec={k.dec ?? 0}
              data-group={k.group ? "1" : ""}
            >
              {k.pre ?? ""}0{k.suf ?? ""}
            </dt>
            <dd class="stat-label">{k.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .plan__head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .plan__chart {
    padding: clamp(1rem, 3vw, 2rem);
  }
  .plan__chart svg {
    width: 100%;
    height: auto;
  }
  .plan__grid {
    stroke: var(--gray-200);
    stroke-width: 1;
  }
  .plan__area {
    opacity: 0;
    transition: opacity 0.8s var(--ease) 0.6s;
  }
  .plan__chart.is-visible .plan__area {
    opacity: 1;
  }
  .plan__line {
    stroke: var(--green-dark);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
  }
  .plan__chart.is-visible .plan__line {
    animation: drawPlan 1.4s var(--ease) forwards;
  }
  @keyframes drawPlan {
    to {
      stroke-dashoffset: 0;
    }
  }
  .plan__pt circle {
    fill: var(--white);
    stroke: var(--green-dark);
    stroke-width: 3;
    opacity: 0;
  }
  .plan__chart.is-visible .plan__pt circle {
    animation: popIn 0.4s var(--ease) forwards;
    animation-delay: var(--d);
  }
  .plan__pv {
    font-size: 13px;
    font-weight: 700;
    fill: var(--green-inst);
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
    opacity: 0;
  }
  .plan__chart.is-visible .plan__pv {
    animation: fadeUp 0.5s var(--ease) forwards;
    animation-delay: var(--d);
  }
  .plan__pm {
    font-size: 12px;
    fill: var(--gray-text);
    text-anchor: middle;
    font-weight: 500;
  }

  .plan__timeline {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .plan__timeline {
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
    }
  }
  .plan__step {
    position: relative;
    padding-top: 1.4rem;
    padding-right: 1rem;
  }
  .plan__step::before {
    content: "";
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gray-200);
  }
  .plan__step:first-child::before {
    left: 5px;
  }
  .plan__step:last-child::before {
    right: calc(100% - 11px);
  }
  .plan__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-wash);
  }
  .plan__m {
    display: block;
    font-weight: 600;
    color: var(--green-inst);
    font-size: var(--step-0);
  }
  .plan__note {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--gray-text);
    line-height: 1.4;
  }

  .plan__kpis {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: var(--border);
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 680px) {
    .plan__kpis {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .plan__kpi .stat-num {
    color: var(--green-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .plan__line {
      stroke-dashoffset: 0;
    }
    .plan__pt circle,
    .plan__pv,
    .plan__area {
      opacity: 1;
    }
  }
</style>
