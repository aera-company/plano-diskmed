---
const wpp =
  "https://wa.me/5521999795699?text=" +
  encodeURIComponent(
    "Olá Jefferson, vi a proposta de desenvolvimento comercial para a DiskMed e gostaria de conversar."
  );

const stats = [
  { v: 40, suf: "+", label: "Anos de mercado" },
  { v: 246, label: "Lojas expandidas" },
  { v: 7276, label: "Lojas no RJ", group: true },
  { pre: "R$ ", v: 24, suf: " Bi", label: "Mercado RJ" },
];
---

<section id="hero" class="hero section">
  <picture class="hero__bg">
    <source srcset="/images/rj-hero.webp" type="image/webp" />
    <img
      src="/images/rj-hero.png"
      alt=""
      aria-hidden="true"
      width="1448"
      height="1086"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="container container-wide hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow" data-reveal>
        <span></span> Proposta executiva · DiskMed Distribuidora
      </p>
      <h1 class="hero__title" data-reveal style="--reveal-delay:80ms">
        Acelerando o crescimento da DiskMed nos canais que mais crescem no
        varejo farmacêutico.
      </h1>
      <p class="hero__sub" data-reveal style="--reveal-delay:160ms">
        Mais de 40 anos de mercado farmacêutico, relacionamento consolidado com
        redes, associações e indústria — transformados em desenvolvimento
        comercial, expansão de mercado e geração de novos negócios.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay:240ms">
        <a class="btn btn--lg" href={wpp} target="_blank" rel="noopener">
          Agendar conversa
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn--ghost btn--lg" href="#jefferson">Conhecer a trajetória</a>
      </div>
    </div>

    <dl class="hero__stats" data-reveal>
      {
        stats.map((s) => (
          <div class="hero__stat">
            <dt
              class="stat-num"
              data-count={s.v}
              data-pre={s.pre ?? ""}
              data-suf={s.suf ?? ""}
              data-group={s.group ? "1" : ""}
            >
              {s.pre ?? ""}0{s.suf ?? ""}
            </dt>
            <dd class="stat-label">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 6vw, 5rem);
    display: flex;
    align-items: center;
    min-height: clamp(560px, 82vh, 800px);
  }
  .hero__bg {
    position: absolute;
    z-index: 0;
    right: -1%;
    top: 47%;
    width: min(1440px, 67%);
    pointer-events: none;
    user-select: none;
    transform: translateY(-50%);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%, #000);
    mask-image: linear-gradient(to right, transparent, #000 18%, #000);
  }
  .hero__bg img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero__copy {
    max-width: 620px;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--green-dark);
    font-weight: 500;
    margin-bottom: 1.6rem;
  }
  .hero__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-wash);
  }
  .hero__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .hero__sub {
    font-size: var(--step-1);
    color: var(--gray-text);
    max-width: 48ch;
    margin-top: 1.6rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 2.6rem);
    border-top: var(--border);
  }
  @media (min-width: 720px) {
    .hero__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .hero__stat {
    text-align: center;
  }
  .hero__stat .stat-num {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem);
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .hero__bg {
      width: 135%;
      right: -22%;
      top: auto;
      bottom: -2%;
      opacity: 0.4;
      animation: none;
      transform: none;
    }
    .hero__copy {
      max-width: none;
    }
  }
</style>
