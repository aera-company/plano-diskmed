---
// Donut: circunferência = 100 (r = 100 / 2π) → cada % = 1 unidade de traço.
const r = 15.915;
const segments = [
  { label: "ABRAFARMA", value: 55, color: "var(--green-inst)", organized: true },
  { label: "Associações e franquias", value: 17.7, color: "var(--green)", organized: true },
  { label: "Independentes", value: 17.7, color: "var(--green-dark)", organized: false },
  { label: "Outras redes", value: 9.1, color: "var(--gray-300)", organized: true },
];

// Os valores da fonte somam 99,5% (arredondamento). Normalizamos o COMPRIMENTO
// dos arcos para fechar 100% (sem fresta), mas exibimos os rótulos originais.
const total = segments.reduce((s, x) => s + x.value, 0);
let acc = 0;
const arcs = segments.map((s) => {
  const len = (s.value / total) * 100;
  const seg = { ...s, len, offset: acc };
  acc += len;
  return seg;
});

// "Canais organizados" = tudo, exceto independentes (justamente a tese da seção).
const organizedPct = Math.round(
  segments.filter((s) => s.organized).reduce((sum, s) => sum + s.value, 0)
);
---

<section id="oportunidade" class="section bg-soft opp">
  <div class="container container-wide opp__grid">
    <figure class="opp__chart" data-reveal>
      <svg viewBox="0 0 42 42" role="img" aria-label="Distribuição dos canais de varejo farmacêutico">
        <circle class="opp__track" cx="21" cy="21" r={r}></circle>
        {
          arcs.map((a, i) => (
            <circle
              class="opp__seg"
              cx="21"
              cy="21"
              r={r}
              stroke={a.color}
              style={`--len:${a.len}; --off:${a.offset}; --d:${i * 0.18 + 0.1}s`}
              data-len={a.value}
            ></circle>
          ))
        }
        <text class="opp__center-v" x="21" y="20.5">{organizedPct}%</text>
        <text class="opp__center-l" x="21" y="25">canais organizados</text>
      </svg>
    </figure>

    <div class="opp__body">
      <p class="eyebrow eyebrow--line" data-num="06" data-reveal>
        Onde está a oportunidade
      </p>
      <ul class="opp__legend" data-reveal style="--reveal-delay:120ms">
        {
          segments.map((s) => (
            <li class="opp__item">
              <span class="opp__swatch" style={`background:${s.color}`} />
              <span class="opp__name">{s.label}</span>
              <span class="opp__val">{String(s.value).replace(".", ",")}%</span>
            </li>
          ))
        }
      </ul>
      <p class="opp__text" data-reveal style="--reveal-delay:200ms">
        Os canais organizados representam a principal oportunidade para
        crescimento sustentável da participação de mercado da DiskMed.
      </p>
    </div>
  </div>
</section>

<style>
  .opp__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 860px) {
    .opp__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .opp__chart {
    max-width: 380px;
    margin-inline: auto;
  }
  .opp__chart svg {
    width: 100%;
    height: auto;
    transform: rotate(-90deg);
  }
  .opp__track {
    fill: none;
    stroke: var(--gray-200);
    stroke-width: 4;
  }
  .opp__seg {
    fill: none;
    stroke-width: 4.4;
    stroke-linecap: butt;
    stroke-dasharray: 0 100;
    stroke-dashoffset: calc(var(--off) * -1);
    transition: stroke-dasharray 1s var(--ease);
    transition-delay: var(--d);
  }
  .opp__chart.is-visible .opp__seg {
    stroke-dasharray: var(--len) calc(100 - var(--len));
  }
  .opp__center-v,
  .opp__center-l {
    transform: rotate(90deg);
    transform-origin: center;
    text-anchor: middle;
    fill: var(--green-inst);
  }
  .opp__center-v {
    font-size: 7px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .opp__center-l {
    font-size: 2.1px;
    font-weight: 500;
    fill: var(--gray-text);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .opp__legend {
    list-style: none;
    display: grid;
    gap: 0.2rem;
    margin-top: 1.4rem;
  }
  .opp__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: var(--border);
  }
  .opp__swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .opp__name {
    font-size: var(--step-0);
    color: var(--ink);
    font-weight: 500;
  }
  .opp__val {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--green-inst);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .opp__text {
    margin-top: 1.8rem;
    font-size: var(--step-1);
    color: var(--gray-text);
    max-width: 50ch;
    line-height: 1.5;
  }
</style>
