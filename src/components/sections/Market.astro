---
const stats = [
  { pre: "R$ ", v: 24, suf: " bi", label: "Mercado total" },
  { v: 7276, group: true, label: "Lojas" },
  { v: 26.8, suf: "%", label: "Associações, franquias e redes", dec: 1 },
  { v: 1700, group: true, label: "Clientes atuais DiskMed" },
];

// Posições (% da imagem) dos pontos de cada região — alinhadas aos marcadores
// já presentes no mapa em anexo. A animação pulsa sobre cada região.
const spots = [
  { x: 66.8, y: 21, name: "Noroeste Fluminense" },
  { x: 79.7, y: 38.5, name: "Norte Fluminense" },
  { x: 55.2, y: 51.5, name: "Centro Fluminense" },
  { x: 18.6, y: 63, name: "Sul Fluminense" },
  { x: 38, y: 71.4, name: "Metropolitana do Rio de Janeiro" },
  { x: 62.5, y: 67.7, name: "Baixadas" },
];
---

<section id="mercado" class="section market">
  <div class="container container-wide market__grid">
    <div class="market__copy">
      <p class="eyebrow eyebrow--line" data-num="05" data-reveal>Mercado RJ</p>
      <h2 class="section-title" data-reveal>
        Um mercado de R$ 24 bilhões com oportunidades ainda pouco exploradas.
      </h2>

      <dl class="market__stats" data-reveal style="--reveal-delay:120ms">
        {
          stats.map((s) => (
            <div class="market__stat">
              <dt
                class="stat-num"
                data-count={s.v}
                data-pre={s.pre ?? ""}
                data-suf={s.suf ?? ""}
                data-dec={s.dec ?? 0}
                data-group={s.group ? "1" : ""}
              >
                {s.pre ?? ""}0{s.suf ?? ""}
              </dt>
              <dd class="stat-label">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="market__map" data-reveal style="--reveal-delay:160ms">
      <img
        src="/images/rj-regioes.jpg"
        alt="Mapa do Estado do Rio de Janeiro dividido por regiões: Noroeste, Norte, Centro, Sul, Metropolitana e Baixadas"
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <div class="market__spots" aria-hidden="true">
        {
          spots.map((s, i) => (
            <span
              class="market__spot"
              title={s.name}
              style={`left:${s.x}%; top:${s.y}%; --d:${i * 0.4}s`}
            />
          ))
        }
      </div>
      <figcaption>Concentração de oportunidades por região do Estado</figcaption>
    </figure>
  </div>
</section>

<style>
  .market__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 920px) {
    .market__grid {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }
  .market__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.2rem);
    margin-top: 2.6rem;
  }
  .market__stat .stat-num {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
  }

  .market__map {
    position: relative;
  }
  .market__map img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
  .market__spots {
    position: absolute;
    inset: 0;
  }
  .market__spot {
    position: absolute;
    width: 13px;
    height: 13px;
    transform: translate(-50%, -50%);
  }
  .market__spot::before,
  .market__spot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  /* marcador sólido */
  .market__spot::before {
    background: var(--green-inst);
    border: 2px solid var(--white);
    box-shadow: 0 1px 4px rgba(22, 74, 26, 0.35);
    z-index: 1;
  }
  /* anel pulsante */
  .market__spot::after {
    background: var(--green);
    opacity: 0.55;
    animation: mapPulse 2.6s var(--ease) infinite;
    animation-delay: var(--d);
  }
  @keyframes mapPulse {
    0% {
      transform: scale(0.8);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .market__map figcaption {
    margin-top: 1.2rem;
    text-align: center;
    font-size: var(--step--1);
    color: var(--gray-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .market__spot::after {
      animation: none;
      opacity: 0.3;
    }
  }
</style>
