---
const flow = [
  "Jefferson Lima",
  "Relacionamento estratégico",
  "Desenvolvimento de negócios",
  "DiskMed",
];
const outcomes = ["Faturamento", "Positivação", "Participação de mercado"];
---

<section id="modelo" class="section model">
  <div class="container container-wide">
    <header class="model__head">
      <p class="eyebrow eyebrow--line" data-num="10" data-reveal>
        Modelo de atuação
      </p>
      <h2 class="section-title" data-reveal>
        Uma engrenagem complementar à equipe comercial.
      </h2>
    </header>

    <div class="model__flow" data-reveal>
      {
        flow.map((step, i) => (
          <div class="model__stage-wrap" style={`--reveal-delay:${i * 90}ms`}>
            <div class:list={["model__stage", { "model__stage--end": i === flow.length - 1 }]}>
              <span class="model__stage-i">{String(i + 1).padStart(2, "0")}</span>
              <span class="model__stage-label">{step}</span>
            </div>
            {i < flow.length - 1 && (
              <svg class="model__conn" width="40" height="16" viewBox="0 0 40 16" aria-hidden="true">
                <path d="M0 8h32M27 3l6 5-6 5" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </div>
        ))
      }
    </div>

    <div class="model__outcomes" data-reveal style="--reveal-delay:200ms">
      {outcomes.map((o) => <span class="model__outcome">{o}</span>)}
    </div>

    <p class="model__note" data-reveal>
      Atuação complementar à equipe comercial existente. Foco em
      <strong> abertura de oportunidades</strong>, desenvolvimento de negócios e
      crescimento sustentável.
    </p>
  </div>
</section>

<style>
  .model__head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .model__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
  }
  .model__stage-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 auto;
  }
  .model__stage {
    flex: 1;
    min-width: 150px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.3rem;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--white);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .model__stage:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--green);
  }
  .model__stage--end {
    background: var(--green-inst);
    border-color: var(--green-inst);
  }
  .model__stage--end .model__stage-label {
    color: #fff;
  }
  .model__stage--end .model__stage-i {
    color: var(--green);
  }
  .model__stage-i {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--green);
  }
  .model__stage-label {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--green-inst);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .model__conn {
    flex: none;
  }

  .model__outcomes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px dashed var(--gray-300);
  }
  .model__outcome {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.2rem;
    background: var(--green-wash);
    color: var(--green-inst);
    border-radius: 100px;
    font-weight: 500;
    font-size: var(--step-0);
  }
  .model__outcome::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }
  .model__note {
    margin-top: 2.2rem;
    max-width: 60ch;
    font-size: var(--step-1);
    color: var(--gray-text);
    line-height: 1.5;
  }
  .model__note strong {
    color: var(--green-inst);
    font-weight: 600;
  }
  @media (max-width: 680px) {
    .model__stage-wrap {
      flex: 1 1 100%;
      flex-direction: column;
    }
    .model__conn {
      transform: rotate(90deg);
    }
  }
</style>
