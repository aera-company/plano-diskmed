---
import Logo from "./Logo.astro";

const wpp =
  "https://wa.me/5521999795699?text=" +
  encodeURIComponent(
    "Olá Jefferson, vi a proposta de desenvolvimento comercial para a DiskMed e gostaria de conversar."
  );
---

<header class="nav" data-nav>
  <div class="nav__inner container container-wide">
    <Logo />
    <nav class="nav__links" aria-label="Seções">
      <a href="#jefferson">Quem é</a>
      <a href="#mercado">Mercado RJ</a>
      <a href="#oportunidade">Oportunidade</a>
      <a href="#plano">12 meses</a>
      <a href="#retorno">Retorno</a>
    </nav>
    <a class="btn nav__cta" href={wpp} target="_blank" rel="noopener">
      Agendar conversa
    </a>
  </div>
  <div class="nav__progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--white) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--gray-200);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 72px;
  }
  .nav__links {
    display: none;
    margin-inline: auto;
    gap: 2rem;
    font-size: var(--step--1);
    color: var(--gray-text);
  }
  .nav__links a {
    position: relative;
    transition: color 0.25s var(--ease);
  }
  .nav__links a:hover {
    color: var(--green-inst);
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 2px;
    background: var(--green);
    transition: width 0.3s var(--ease);
  }
  .nav__links a:hover::after {
    width: 100%;
  }
  .nav__cta {
    margin-left: auto;
    padding: 0.7rem 1.25rem;
    font-size: var(--step--1);
  }
  .nav__progress {
    height: 2px;
    width: var(--p, 0%);
    background: linear-gradient(90deg, var(--green-dark), var(--green));
    transition: width 0.1s linear;
  }
  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
    .nav__cta {
      margin-left: 0;
    }
  }
  @media (max-width: 560px) {
    .nav__cta {
      display: none;
    }
  }
</style>
